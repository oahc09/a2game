{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:a2game:schemas:coverage:0.1.0",
  "title": "A2Game Coverage Registry 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "registryVersion",
    "games"
  ],
  "properties": {
    "format": {
      "const": "a2game-coverage"
    },
    "registryVersion": {
      "const": "0.1.0"
    },
    "games": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/coverageEntry"
      }
    }
  },
  "$defs": {
    "capRef": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*){2,}$"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        }
      },
      "additionalProperties": false
    },
    "requires": {
      "type": "object",
      "required": [
        "all"
      ],
      "properties": {
        "all": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capRef"
          },
          "uniqueItems": true
        },
        "anyOf": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/capRef"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "coverageEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "name",
        "taxonomy",
        "executionModels",
        "dimensions",
        "inputs",
        "requiredCapabilities",
        "optionalCapabilities",
        "testSuites",
        "profiles",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "taxonomy": {
          "type": "object",
          "required": [
            "genres",
            "mechanics"
          ],
          "properties": {
            "genres": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "mechanics": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false
        },
        "executionModels": {
          "type": "array",
          "items": {
            "enum": [
              "discrete",
              "realtime",
              "mixed",
              "timed",
              "turnbased"
            ]
          }
        },
        "dimensions": {
          "type": "array",
          "items": {
            "enum": [
              "2d",
              "2.5d",
              "3d"
            ]
          }
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requiredCapabilities": {
          "$ref": "#/$defs/requires"
        },
        "optionalCapabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capRef"
          }
        },
        "testSuites": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "profiles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "status": {
          "enum": [
            "planned",
            "documented-only",
            "implemented-unverified",
            "verified"
          ]
        },
        "sourceLinks": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "extensions": {
          "type": "object"
        }
      }
    }
  }
}
