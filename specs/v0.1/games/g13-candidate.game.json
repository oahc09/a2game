                  {
                    "tick": 170,
                    "body": {
                      "id": "checkpoint_2",
                      "kind": "pickup",
                      "x": 4000,
                      "y": 5500,
                      "vx": 0,
                      "vy": -64,
                      "hx": 2000,
                      "hy": 60,
                      "hp": 1,
                      "team": 2,
