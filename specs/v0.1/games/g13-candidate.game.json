              },
              "config": {
                "statePath": "/world",
                "width": 8000,
                "height": 6000,
                "laneCenters": [
                  2000,
                  4000,
                  6000
                ],
                "maxTicks": 300,
                "actions": {
                  "laneLeft": "left",
                  "laneRight": "right"
                },
                "waves": [
                  {
                    "tick": 35,
                    "body": {
                      "id": "checkpoint_1",
                      "kind": "pickup",
                      "x": 4000,
                      "y": 5500,
                      "vx": 0,
