    "world": {
      "type": "object",
      "initial": {
        "bodies": [
          {
            "id": "hero",
            "kind": "actor",
            "x": 4000,
            "y": 1000,
            "vx": 0,
            "vy": 0,
            "hx": 100,
            "hy": 100,
            "hp": 1,
            "team": 1,
            "value": 0,
