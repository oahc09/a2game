          {
            "id": "obstacle_a",
            "kind": "solid",
            "x": 4000,
            "y": 5500,
            "vx": 0,
            "vy": -64,
            "hx": 350,
            "hy": 180,
            "hp": 1,
            "team": 2,
            "value": 0,
            "fixed": false,
            "ttl": 90
          }
        ],
        "score": 0,
        "charge": 0,
        "nextId": 0,
        "cooldowns": {},
        "contacts": [],
        "spawned": [],
        "grounded": [],
        "won": false,
        "lost": false
      }
    },
    "runner": {
      "type": "object",
      "initial": {
        "checkpoints": 0,
        "kills": 0,
        "crashed": false
      }
    }
  },
  "inputs": {
    "actions": [
      {
        "id": "left",
        "valueType": "button",
        "bindings": [
          {
            "source": "keyboard.button",
            "config": {
              "code": "ArrowLeft"
            }
          },
          {
            "source": "touch.swipe",
            "config": {
              "direction": "left"
            }
          }
        ]
      },
      {
        "id": "right",
        "valueType": "button",
        "bindings": [
          {
            "source": "keyboard.button",
            "config": {
              "code": "ArrowRight"
            }
          },
          {
            "source": "touch.swipe",
            "config": {
              "direction": "right"
            }
          }
        ]
      }
    ]
  },
  "rules": [
    {
      "id": "crash-a",
      "on": {
        "type": "contact.begin"
      },
      "if": {
        "op": "eq",
        "args": [
          {
            "event": "/pair"
          },
          {
            "const": "hero|obstacle_a"
          }
        ]
      },
      "do": [
        {
          "op": "state.set",
          "path": "/runner/crashed",
          "value": true
        }
      ]
    },
    {
      "id": "crash-b",
      "on": {
        "type": "contact.begin"
      },
      "if": {
        "op": "eq",
        "args": [
          {
            "event": "/pair"
          },
          {
            "const": "hero|obstacle_b"
          }
        ]
      },
      "do": [
        {
          "op": "state.set",
          "path": "/runner/crashed",
          "value": true
        }
      ]
    },
    {
      "id": "crash-c",
      "on": {
        "type": "contact.begin"
      },
      "if": {
        "op": "eq",
        "args": [
          {
            "event": "/pair"
          },
          {
            "const": "hero|obstacle_c"
          }
        ]
      },
      "do": [
        {
          "op": "state.set",
          "path": "/runner/crashed",
          "value": true
        }
      ]
    },
    {
      "id": "checkpoint-1",
      "on": {
        "type": "realtime.trigger"
      },
      "if": {
        "op": "and",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "event": "/id"
              },
              {
                "const": "checkpoint_1"
              }
            ]
          },
          {
            "op": "eq",
            "args": [
              {
                "state": "/runner/checkpoints"
              },
              {
                "const": 0
              }
            ]
          }
        ]
      },
      "do": [
        {
          "op": "state.set",
          "path": "/runner/checkpoints",
          "value": 1
        }
      ]
    },
    {
      "id": "checkpoint-2",
      "on": {
        "type": "realtime.trigger"
      },
      "if": {
        "op": "and",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "event": "/id"
              },
              {
                "const": "checkpoint_2"
              }
            ]
          },
          {
            "op": "eq",
            "args": [
              {
                "state": "/runner/checkpoints"
              },
              {
                "const": 1
              }
            ]
          }
        ]
      },
      "do": [
        {
          "op": "state.set",
          "path": "/runner/checkpoints",
          "value": 2
        }
      ]
    }
  ],
  "outcomes": [
    {
      "id": "finish",
      "status": "won",
      "when": {
        "op": "eq",
        "args": [
          {
            "state": "/runner/checkpoints"
          },
          {
            "const": 2
          }
        ]
      }
    },
    {
      "id": "crash",
      "status": "lost",
      "priority": -2,
      "when": {
        "op": "or",
        "args": [
          {
            "state": "/runner/crashed"
          },
          {
            "state": "/world/lost"
          }
        ]
      }
    }
  ],
  "presentation": {
    "hud": [
