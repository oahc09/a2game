        "id": "counters",
        "kind": "text",
        "bind": {
          "text": {
            "template": "长按 {0} · 多指 {1} · 摇动 {2}",
            "args": [
              {
                "state": "/hold"
              },
              {
                "state": "/multi"
              },
              {
                "state": "/shake"
              }
            ]
          }
        }
      }
    ],
    "cues": [],
    "scene2d": {
      "width": 8,
      "height": 6,
      "background": "#0d1729",
      "nodes": [
        {
          "id": "title",
          "kind": "text",
          "at": [
            0,
            2.4
          ],
          "fontSize": 0.32,
          "fill": "#b5cee8",
          "text": {
            "literal": "Mobile Input / Trace"
          }
        },
        {
          "id": "target",
          "kind": "rect",
          "at": [
