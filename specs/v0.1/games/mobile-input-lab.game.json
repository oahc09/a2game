          "value": {
            "event": "/value"
          }
        }
      ]
    },
    {
      "id": "on-rotate",
      "on": {
        "type": "input.action",
        "action": "rotate",
        "edge": "press"
      },
      "do": [
        {
          "op": "state.set",
          "path": "/rotate",
          "value": {
            "event": "/value"
          }
        }
      ]
    },
    {
      "id": "on-multi",
      "on": {
        "type": "input.action",
        "action": "multi",
        "edge": "press"
      },
      "do": [
        {
          "op": "state.add",
          "path": "/multi",
          "value": 1
        }
      ]
    },
    {
      "id": "on-tilt",
      "on": {
        "type": "input.action",
        "action": "tilt",
        "edge": "press"
      },
      "do": [
        {
          "op": "state.set",
          "path": "/tilt",
          "value": {
            "event": "/value"
          }
        }
      ]
    },
    {
      "id": "on-shake",
      "on": {
        "type": "input.action",
        "action": "shake",
        "edge": "press"
      },
      "do": [
        {
          "op": "state.add",
          "path": "/shake",
          "value": 1
        }
      ]
    },
    {
      "id": "on-orientation",
      "on": {
        "type": "input.action",
        "action": "orientation",
