    },
    {
      "id": "on-acceleration",
      "on": {
        "type": "input.action",
        "action": "acceleration",
        "edge": "press"
      },
      "do": [
        {
          "op": "state.set",
          "path": "/acceleration",
          "value": {
            "event": "/value"
          }
        }
      ]
    },
    {
      "id": "on-gyroscope",
      "on": {
        "type": "input.action",
        "action": "gyroscope",
        "edge": "press"
      },
      "do": [
        {
          "op": "state.set",
          "path": "/gyroscope",
          "value": {
            "event": "/value"
          }
        }
      ]
    },
    {
      "id": "on-calibration",
      "on": {
        "type": "input.action",
        "action": "calibration",
        "edge": "press"
      },
      "do": [
        {
          "op": "state.add",
          "path": "/calibration",
          "value": 1
        }
      ]
    }
  ],
  "outcomes": [],
  "presentation": {
    "hud": [
