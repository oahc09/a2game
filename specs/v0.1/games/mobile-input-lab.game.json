          ],
          "fontSize": 0.26,
          "fill": "#b5cee8",
          "text": {
            "state": "/multi"
          }
        },
        {
          "id": "pinch-value",
          "kind": "text",
          "at": [
            0,
            -0.3
          ],
          "fontSize": 0.26,
          "fill": "#b5cee8",
          "text": {
