{
  "format": "a2game",
  "specVersion": "0.1.0",
  "id": "org.a2game.samples.gamepad-lab",
  "revision": 2,
  "meta": {
    "title": "手柄扩展与键盘回退",
    "genres": [
      "casual"
    ],
    "description": "显式启用手柄，按钮 0 点击三次，摇杆向右；物理设备另验。"
  },
  "requires": {
    "all": [
      {
        "id": "a2game.core.state",
        "version": "0.1.0"
      },
      {
        "id": "a2game.core.rules",
        "version": "0.1.0"
      },
      {
        "id": "a2game.core.flow",
        "version": "0.1.0"
      },
      {
        "id": "a2game.rules.state-add",
        "version": "0.1.0"
      },
      {
        "id": "a2game.visual.text",
        "version": "0.1.0"
      },
      {
        "id": "a2game.visual.scene2d",
        "version": "0.1.0"
      },
      {
        "id": "a2game.input.gamepad.button",
        "version": "0.1.0"
      },
      {
        "id": "a2game.input.gamepad.axis2",
        "version": "0.1.0"
      },
      {
        "id": "a2game.input.keyboard.button",
        "version": "0.1.0"
      },
      {
        "id": "a2game.rules.state-set",
        "version": "0.1.0"
      }
    ]
  },
  "world": {
    "dimension": "2d",
    "coordinateSystem": "rh-y-up",
    "units": "meter",
    "clock": {
      "tickHz": 60,
      "seed": 42,
      "maxCatchUpTicks": 5
    }
  },
  "assets": {},
  "prototypes": {},
  "scenes": [
    {
      "id": "main",
      "entities": []
    }
  ],
  "entryScene": "main",
  "state": {
    "score": {
      "type": "int",
      "initial": 0
    },
    "goal": {
      "type": "int",
      "initial": 3
    },
    "axis": {
      "type": "vec2",
      "initial": [
        0,
        0
      ]
    }
  },
  "inputs": {
    "traceRecording": "user-opt-in",
    "actions": [
      {
        "id": "collect",
        "valueType": "button",
        "bindings": [
          {
            "source": "gamepad.button",
            "config": {
              "button": 0
            }
          },
          {
            "source": "keyboard.button",
            "config": {
              "code": "Space"
            }
          }
        ]
      },
      {
        "id": "look",
        "valueType": "vec2",
        "bindings": [
          {
            "source": "gamepad.axis2",
            "config": {
              "xAxis": 0,
              "yAxis": 1,
              "deadZone": 0.1
            }
          }
        ]
      },
      {
        "id": "lookRight",
        "valueType": "button",
        "bindings": [
          {
            "source": "keyboard.button",
            "config": {
              "code": "ArrowRight"
            }
          }
        ]
      }
    ]
  },
  "rules": [
    {
      "id": "reward-on-press",
      "priority": 0,
      "on": {
        "type": "input.action",
        "action": "collect",
        "edge": "press"
      },
      "if": {
        "op": "lt",
        "args": [
          {
            "state": "/score"
          },
          {
            "state": "/goal"
          }
        ]
      },
      "do": [
        {
          "op": "state.add",
          "path": "/score",
          "value": 1
        }
      ]
    },
    {
      "id": "keyboard-axis",
      "on": {
        "type": "input.action",
        "action": "lookRight",
        "edge": "press"
      },
      "do": [
        {
          "op": "state.set",
          "path": "/axis",
          "value": [
            1,
            0
          ]
        }
      ]
    },
    {
      "id": "look-axis",
      "on": {
        "type": "input.action",
        "action": "look",
        "edge": "press"
      },
      "do": [
        {
          "op": "state.set",
          "path": "/axis",
          "value": {
            "event": "/value"
          }
        }
      ]
    }
  ],
  "outcomes": [
    {
      "id": "all-collected",
      "status": "won",
      "priority": 0,
      "when": {
        "op": "and",
        "args": [
          {
            "op": "gte",
            "args": [
              {
                "state": "/score"
              },
              {
                "const": 3
              }
            ]
          },
          {
            "op": "gt",
            "args": [
              {
                "state": "/axis/0"
              },
              {
                "const": 0.5
              }
            ]
          }
        ]
      }
    }
  ],
  "presentation": {
    "hud": [
      {
        "id": "gamepad",
        "kind": "text",
        "bind": {
          "text": {
            "template": "按钮 {0}/3 · 轴 {1}",
            "args": [
              {
                "state": "/score"
              },
              {
                "state": "/axis/0"
              }
            ]
          }
        }
      }
    ],
    "cues": [],
    "scene2d": {
      "width": 8,
      "height": 6,
      "background": "#0d1729",
      "nodes": [
        {
          "id": "outer",
          "kind": "circle",
          "at": [
            0,
            0
          ],
          "fill": "#173955",
          "radius": 1.7
        },
        {
          "id": "target",
          "kind": "circle",
          "at": [
            0,
            0
          ],
          "fill": "#2c91c5",
          "radius": 1.34
        },
        {
          "id": "center",
          "kind": "circle",
          "at": [
            0,
            0
          ],
          "fill": "#6ed2ef",
          "radius": 0.85
        },
        {
          "id": "score",
          "kind": "text",
          "at": [
            0,
            0
          ],
          "fill": "#0c3556",
          "fontSize": 0.8,
          "text": {
            "state": "/score"
          }
        },
        {
          "id": "title",
          "kind": "text",
          "at": [
            0,
            2.45
          ],
          "fill": "#c8e5fd",
          "fontSize": 0.32,
          "text": {
            "literal": "A2Game / Tap to score"
          }
        }
      ]
    }
  },
  "tests": [
    "../tests/gamepad-lab.conformance.json"
  ],
  "extensions": {}
}
