  "rules": [
    {
      "id": "upgrade-bonus",
      "on": {
        "type": "input.action",
        "action": "upgrade",
        "edge": "press"
      },
      "if": {
        "op": "eq",
        "args": [
          {
            "state": "/skill/active"
          },
          {
            "const": false
          }
        ]
      },
      "do": [
        {
          "op": "state.set",
          "path": "/skill/bonus",
          "value": {
            "state": "/economy/plots/0/level"
          }
        }
      ]
    },
    {
      "id": "upgrade-during-skill",
      "on": {
        "type": "input.action",
        "action": "upgrade",
        "edge": "press"
      },
      "if": {
        "state": "/skill/active"
      },
      "do": [
        {
          "op": "state.set",
          "path": "/skill/bonus",
          "value": {
            "op": "add",
            "args": [
              {
                "state": "/economy/plots/0/level"
              },
              {
                "const": 4
              }
            ]
          }
        }
      ]
    },
    {
      "id": "skill-cast",
      "on": {
        "type": "input.action",
        "action": "skill",
        "edge": "press"
      },
      "if": {
        "op": "and",
        "args": [
          {
            "op": "gt",
            "args": [
              {
                "state": "/skill/charges"
              },
              {
                "const": 0
              }
            ]
          },
          {
            "op": "eq",
            "args": [
              {
                "state": "/skill/active"
              },
              {
                "const": false
              }
            ]
          }
        ]
      },
      "do": [
        {
          "op": "state.add",
          "path": "/skill/charges",
          "value": -1
        },
        {
          "op": "state.add",
          "path": "/skill/used",
          "value": 1
        },
        {
          "op": "state.set",
          "path": "/skill/active",
          "value": true
        },
        {
          "op": "state.set",
          "path": "/skill/bonus",
          "value": {
            "op": "add",
            "args": [
              {
                "state": "/economy/plots/0/level"
              },
              {
                "const": 4
              }
            ]
          }
        },
        {
          "op": "timer.schedule",
          "id": "skill-end",
          "delayTicks": 40,
          "eventType": "skill.expired"
        }
      ]
    },
    {
      "id": "skill-expire",
      "on": {
        "type": "skill.expired"
      },
      "do": [
        {
          "op": "state.set",
          "path": "/skill/active",
          "value": false
        },
        {
          "op": "state.set",
          "path": "/skill/bonus",
          "value": {
            "state": "/economy/plots/0/level"
          }
        }
      ]
    }
  ],
  "outcomes": [
    {
      "id": "won",
      "status": "won",
      "when": {
        "state": "/world/won"
      }
    },
    {
      "id": "lost",
      "status": "lost",
      "priority": -1,
      "when": {
        "state": "/world/lost"
      }
    }
  ],
