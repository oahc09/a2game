{
  "format": "a2game-capability",
  "manifestVersion": "0.1.0",
  "id": "a2game.strategy.economy-loop",
  "version": "0.1.0",
  "kind": "behavior",
  "portability": "exact",
  "description": "Trusted shared strategy.economy-loop bounded mechanism; no game-name branches.",
  "phase": "simulate",
  "dependencies": [
    {
      "id": "a2game.core.state",
      "version": "0.1.0"
    },
    {
      "id": "a2game.strategy.economy",
      "version": "0.1.0"
    },
    {
      "id": "a2game.strategy.inventory",
      "version": "0.1.0"
    },
    {
      "id": "a2game.strategy.cost",
      "version": "0.1.0"
    },
    {
      "id": "a2game.strategy.reward",
      "version": "0.1.0"
    },
    {
      "id": "a2game.strategy.production",
      "version": "0.1.0"
    },
    {
      "id": "a2game.strategy.collect",
      "version": "0.1.0"
    },
    {
      "id": "a2game.strategy.upgrade",
      "version": "0.1.0"
    },
    {
      "id": "a2game.strategy.unlock",
      "version": "0.1.0"
    },
    {
      "id": "a2game.strategy.shop",
      "version": "0.1.0"
    },
    {
      "id": "a2game.strategy.placement-grid",
      "version": "0.1.0"
    },
    {
      "id": "a2game.strategy.path",
      "version": "0.1.0"
    },
    {
      "id": "a2game.strategy.tower",
      "version": "0.1.0"
    },
    {
      "id": "a2game.strategy.range",
      "version": "0.1.0"
    }
  ],
  "contract": {
    "configSchema": {
      "type": "object",
      "properties": {
        "statePath": {
          "type": "string",
          "pattern": "^/"
        },
        "goalScore": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "products": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "cost": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000
              },
              "yield": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              },
              "reward": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000
              },
              "durationTicks": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000
              },
              "upgradeCost": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000
              },
              "requires": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              }
            },
            "required": [
              "id",
              "cost",
              "yield",
              "reward",
              "durationTicks",
              "upgradeCost"
            ],
            "additionalProperties": false
          },
          "maxItems": 64
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "kind": {
                "enum": [
                  "plant",
                  "collect",
                  "buy",
                  "upgrade",
                  "unlock",
                  "place",
                  "select",
                  "merge"
                ]
              },
              "item": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              "other": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              "cost": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000
              }
            },
            "required": [
              "action",
              "kind"
            ],
            "additionalProperties": false
          },
          "maxItems": 64
        }
      },
      "required": [
        "statePath",
        "products",
        "actions"
      ],
      "additionalProperties": false
    },
    "stateSchema": {
      "type": "object"
    },
    "commands": [],
    "events": [
      {
        "name": "strategy.changed",
        "payloadSchema": {
          "type": "object"
        }
      },
      {
        "name": "strategy.invalid",
        "payloadSchema": {
          "type": "object"
        }
      },
      {
        "name": "strategy.collected",
        "payloadSchema": {
          "type": "object"
        }
      },
      {
        "name": "strategy.upgraded",
        "payloadSchema": {
          "type": "object"
        }
      },
      {
        "name": "strategy.arrived",
        "payloadSchema": {
          "type": "object"
        }
      },
      {
        "name": "strategy.detached",
        "payloadSchema": {
          "type": "object"
        }
      },
      {
        "name": "turn.changed",
        "payloadSchema": {
          "type": "object"
        }
      },
      {
        "name": "turn.invalid",
        "payloadSchema": {
          "type": "object"
        }
      },
      {
        "name": "cards.drawn",
        "payloadSchema": {
          "type": "object"
        }
      },
      {
        "name": "cards.played",
        "payloadSchema": {
          "type": "object"
        }
      }
    ],
    "stateWrites": [
      "global"
    ],
    "lifecycle": [
      "initialize",
      "tick",
      "pause",
      "resume",
      "reset",
      "dispose"
    ]
  },
  "limits": {
    "maxPlots": 16,
    "maxGridCells": 256,
    "maxBoardCells": 361,
    "maxCards": 128,
    "maxHand": 32,
    "maxWaypoints": 64,
    "clock": "shared integer tick; turn actions do not advance production independently"
  },
  "testSuites": [
    "STRATEGY-LIBRARY-001"
  ]
}
