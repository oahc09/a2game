{
  "format": "a2game-capability",
  "manifestVersion": "0.1.0",
  "id": "a2game.realtime.input-control",
  "version": "0.1.0",
  "kind": "behavior",
  "portability": "exact",
  "description": "Trusted declarative input controller: bounded drag/tilt movement, segment/AABB slicing, rotation/scale goals, slingshot requests, drops and balance moments.",
  "phase": "simulate",
  "dependencies": [
    {
      "id": "a2game.core.state",
      "version": "0.1.0"
    },
    {
      "id": "a2game.realtime.intersection",
      "version": "0.1.0"
    },
    {
      "id": "a2game.realtime.rotate",
      "version": "0.1.0"
    },
    {
      "id": "a2game.realtime.collision",
      "version": "0.1.0"
    },
    {
      "id": "a2game.realtime.balance",
      "version": "0.1.0"
    }
  ],
  "contract": {
    "configSchema": {
      "type": "object",
      "properties": {
        "statePath": {
          "type": "string",
          "pattern": "^/"
        },
        "worldPath": {
          "type": "string",
          "pattern": "^/"
        },
        "width": {
          "type": "integer",
          "minimum": 256,
          "maximum": 32000
        },
        "height": {
          "type": "integer",
          "minimum": 256,
          "maximum": 32000
        },
        "sceneWidth": {
          "type": "number",
          "minimum": 1,
          "maximum": 100
        },
        "sceneHeight": {
          "type": "number",
          "minimum": 1,
          "maximum": 100
        },
        "origin": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": -100,
            "maximum": 100
          },
          "minItems": 2,
          "maxItems": 2
        },
        "bodyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "moveMode": {
          "enum": [
            "none",
            "drag",
            "tilt"
          ]
        },
        "speed": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "dragAction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "tiltAction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "orientationAction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "rotateAction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "pinchAction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "pathAction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "rawAction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "spawnAction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "spawnLimit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "spawnValue": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "spawnY": {
          "type": "integer",
          "minimum": 16,
          "maximum": 31984
        },
        "spawnHalfSize": {
          "type": "integer",
          "minimum": 16,
          "maximum": 1000
        },
        "axisFromDrag": {
          "type": "boolean"
        },
        "aimFromDrag": {
          "type": "boolean"
        },
        "slingshot": {
          "type": "boolean"
        },
        "balance": {
          "type": "boolean"
        },
        "balanceGoalTicks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 36000
        },
        "minBalancedBodies": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "failureAngle": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 3.1416
        },
        "targetAngle": {
          "type": "number",
          "minimum": -6.2832,
          "maximum": 6.2832
        },
        "targetScale": {
          "type": "number",
          "minimum": 0.125,
          "maximum": 8
        },
        "angleTolerance": {
          "type": "number",
          "minimum": 0.0001,
          "maximum": 1
        },
        "scaleTolerance": {
          "type": "number",
          "minimum": 0.0001,
          "maximum": 1
        },
        "hazardIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "maxItems": 64
        },
        "goalScore": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      },
      "required": [
        "statePath",
        "worldPath",
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "stateSchema": {
      "type": "object"
    },
    "commands": [],
    "events": [
      {
        "name": "control.changed",
        "payloadSchema": {
          "type": "object"
        }
      },
      {
        "name": "control.invalid",
        "payloadSchema": {
          "type": "object"
        }
      },
      {
        "name": "control.spawned",
        "payloadSchema": {
          "type": "object"
        }
      },
      {
        "name": "control.cut",
        "payloadSchema": {
          "type": "object"
        }
      },
      {
        "name": "control.failed",
        "payloadSchema": {
          "type": "object"
        }
      }
    ],
    "stateWrites": [
      "global"
    ],
    "lifecycle": [
      "initialize",
      "tick",
      "pause",
      "resume",
      "reset",
      "dispose"
    ]
  },
  "limits": {
    "maxObjects": 128,
    "maxCutLedger": 128,
    "maxSegmentPoints": 128,
    "quantization": 0.0001,
    "coordinateProfile": "scene2d-contain-v1; viewport aspect recorded in normalized input",
    "physics": "AABB translation and logical balance moment; no general angular rigid-body solver"
  },
  "testSuites": [
    "INPUT-CONTROL-001"
  ]
}
