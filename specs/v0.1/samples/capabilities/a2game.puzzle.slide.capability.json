{
  "format": "a2game-capability",
  "manifestVersion": "0.1.0",
  "id": "a2game.puzzle.slide",
  "version": "0.1.0",
  "kind": "behavior",
  "portability": "exact",
  "description": "对整型格子执行规则确定的压缩、同值一次合并，可选种子随机补位；不依赖渲染引擎。 Bounded history and RNG restoration are available through historyPath/undoAction.",
  "phase": "simulate",
  "dependencies": [
    {
      "id": "a2game.core.state",
      "version": "0.1.0"
    },
    {
      "id": "a2game.core.rules",
      "version": "0.1.0"
    },
    {
      "id": "a2game.puzzle.undo",
      "version": "0.1.0"
    }
  ],
  "contract": {
    "configSchema": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 2,
          "maximum": 8
        },
        "height": {
          "type": "integer",
          "minimum": 2,
          "maximum": 8
        },
        "boardPath": {
          "type": "string",
          "pattern": "^/"
        },
        "bestPath": {
          "type": "string",
          "pattern": "^/"
        },
        "spawnCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "actions": {
          "type": "object",
          "required": [
            "left",
            "right",
            "up",
            "down"
          ],
          "properties": {
            "left": {
              "type": "string"
            },
            "right": {
              "type": "string"
            },
            "up": {
              "type": "string"
            },
            "down": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "historyPath": {
          "type": "string",
          "pattern": "^/(?:[^~/]|~[01])+$"
        },
        "undoAction": {
          "type": "string",
          "minLength": 1
        },
        "stalledPath": {
          "type": "string",
          "pattern": "^/"
        }
      },
      "required": [
        "width",
        "height",
        "boardPath",
        "bestPath",
        "actions"
      ],
      "additionalProperties": false,
      "dependentRequired": {
        "historyPath": [
          "undoAction"
        ],
        "undoAction": [
          "historyPath"
        ]
      }
    },
    "stateSchema": {
      "type": "object",
      "additionalProperties": false
    },
    "commands": [],
    "events": [
      {
        "name": "grid.moved",
        "payloadSchema": {
          "type": "object",
          "properties": {
            "direction": {
              "type": "string"
            },
            "spawned": {
              "type": "array"
            }
          }
        }
      },
      {
        "name": "puzzle.undone",
        "payloadSchema": {
          "type": "object"
        }
      }
    ],
    "stateWrites": [
      "global"
    ],
    "lifecycle": [
      "initialize",
      "tick",
      "reset",
      "dispose"
    ]
  },
  "testSuites": [
    "PUZZLE-UNDO-001"
  ]
}
