{
  "format": "a2game-capability",
  "manifestVersion": "0.1.0",
  "id": "a2game.visual.stage",
  "version": "0.1.0",
  "kind": "presentation",
  "portability": "host-defined",
  "description": "Versioned camera, textured sprites, mesh/material presets, tick-projected animation, bounded particles and event audio; read-only logical state.",
  "phase": "present",
  "dependencies": [
    {
      "id": "a2game.visual.scene2d",
      "version": "0.1.0"
    }
  ],
  "contract": {
    "configSchema": {
      "type": "object",
      "properties": {
        "camera": {
          "type": "object",
          "properties": {
            "projection": {
              "enum": [
                "perspective",
                "orthographic"
              ]
            },
            "at": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -10000,
                "maximum": 10000
              },
              "minItems": 3,
              "maxItems": 3
            },
            "target": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -10000,
                "maximum": 10000
              },
              "minItems": 3,
              "maxItems": 3
            },
            "near": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "far": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 10000
            },
            "fov": {
              "type": "number",
              "minimum": 10,
              "maximum": 120
            },
            "orthoHeight": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1000
            }
          },
          "required": [
            "projection",
            "at",
            "target",
            "near",
            "far",
            "fov",
            "orthoHeight"
          ],
          "additionalProperties": false
        },
        "nodes": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[_A-Za-z][_A-Za-z0-9-]*$"
              },
              "kind": {
                "enum": [
                  "mesh",
                  "sprite"
                ]
              },
              "geometry": {
                "enum": [
                  "box",
                  "sphere",
                  "plane"
                ]
              },
              "at": {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "number",
                      "minimum": -10000,
                      "maximum": 10000
                    },
                    {
                      "type": "object",
                      "properties": {
                        "state": {
                          "type": "string",
                          "pattern": "^/(?:[^~/]|~[01])+$"
                        }
                      },
                      "required": [
                        "state"
                      ],
                      "additionalProperties": false
                    }
                  ]
                },
                "minItems": 3,
                "maxItems": 3
              },
              "size": {
                "type": "array",
                "items": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 10000
                },
                "minItems": 3,
                "maxItems": 3
              },
              "rotation": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": -10000,
                  "maximum": 10000
                },
                "minItems": 3,
                "maxItems": 3
              },
              "spin": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": -10000,
                  "maximum": 10000
                },
                "minItems": 3,
                "maxItems": 3
              },
              "color": {
                "type": "string",
                "pattern": "^#[A-Fa-f0-9]{6}$"
              },
              "asset": {
                "type": "string",
                "minLength": 1
              },
              "material": {
                "enum": [
                  "unlit",
                  "standard"
                ]
              }
            },
            "required": [
              "id",
              "kind",
              "at",
              "size",
              "color"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "mesh"
                    }
                  }
                },
                "then": {
                  "required": [
                    "geometry"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "sprite"
                    }
                  }
                },
                "then": {
                  "required": [
                    "asset"
                  ]
                }
              }
            ]
          }
        },
        "particles": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[_A-Za-z][_A-Za-z0-9-]*$"
              },
              "count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 128
              },
              "origin": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": -10000,
                  "maximum": 10000
                },
                "minItems": 3,
                "maxItems": 3
              },
              "spread": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": -10000,
                  "maximum": 10000
                },
                "minItems": 3,
                "maxItems": 3
              },
              "velocity": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": -10000,
                  "maximum": 10000
                },
                "minItems": 3,
                "maxItems": 3
              },
              "size": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 10
              },
              "color": {
                "type": "string",
                "pattern": "^#[A-Fa-f0-9]{6}$"
              },
              "periodTicks": {
                "type": "integer",
                "minimum": 1,
                "maximum": 36000
              }
            },
            "required": [
              "id",
              "count",
              "origin",
              "spread",
              "velocity",
              "size",
              "color",
              "periodTicks"
            ],
            "additionalProperties": false
          }
        },
        "audio": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[_A-Za-z][_A-Za-z0-9-]*$"
              },
              "asset": {
                "type": "string",
                "minLength": 1
              },
              "event": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
              },
              "volume": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "id",
              "asset",
              "event",
              "volume"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "camera",
        "nodes"
      ],
      "additionalProperties": false
    },
    "stateSchema": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "commands": [],
    "events": [],
    "stateWrites": [],
    "lifecycle": [
      "initialize",
      "tick",
      "pause",
      "resume",
      "reset",
      "dispose"
    ]
  },
  "testSuites": [
    "VISUAL-STAGE-001"
  ]
}
