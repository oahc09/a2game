{
  "format": "a2game-capability",
  "manifestVersion": "0.1.0",
  "id": "a2game.strategy.tower-defense",
  "version": "0.1.0",
  "kind": "behavior",
  "portability": "exact",
  "description": "Integer fixed-Tick placement, path waves, tower merge/replacement, owned weapons and rewards. No game-name branches or host-side gameplay.",
  "phase": "simulate",
  "dependencies": [
    {
      "id": "a2game.core.state",
      "version": "0.1.0"
    },
    {
      "id": "a2game.strategy.tower",
      "version": "0.1.0"
    },
    {
      "id": "a2game.strategy.range",
      "version": "0.1.0"
    },
    {
      "id": "a2game.strategy.placement-grid",
      "version": "0.1.0"
    },
    {
      "id": "a2game.strategy.cost",
      "version": "0.1.0"
    },
    {
      "id": "a2game.strategy.reward",
      "version": "0.1.0"
    },
    {
      "id": "a2game.combat.wave",
      "version": "0.1.0"
    },
    {
      "id": "a2game.combat.cooldown",
      "version": "0.1.0"
    },
    {
      "id": "a2game.combat.damage",
      "version": "0.1.0"
    }
  ],
  "contract": {
    "configSchema": {
      "type": "object",
      "properties": {
        "statePath": {
          "type": "string",
          "pattern": "^/"
        },
        "width": {
          "type": "integer",
          "minimum": 256,
          "maximum": 32000
        },
        "height": {
          "type": "integer",
          "minimum": 256,
          "maximum": 32000
        },
        "cost": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "damage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "range": {
          "type": "integer",
          "minimum": 16,
          "maximum": 64000
        },
        "speed": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "cooldownTicks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        },
        "maxTicks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "cells": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "x": {
                "type": "integer",
                "minimum": 100,
                "maximum": 31900
              },
              "y": {
                "type": "integer",
                "minimum": 100,
                "maximum": 31900
              }
            },
            "required": [
              "x",
              "y"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 16
        },
        "path": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "x": {
                "type": "integer",
                "minimum": 100,
                "maximum": 31900
              },
              "y": {
                "type": "integer",
                "minimum": 100,
                "maximum": 31900
              }
            },
            "required": [
              "x",
              "y"
            ],
            "additionalProperties": false
          },
          "minItems": 2,
          "maxItems": 64
        },
        "waves": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "tick": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000
              },
              "hp": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000
              },
              "reward": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000
              }
            },
            "required": [
              "tick",
              "hp",
              "reward"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 32
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "kind": {
                "enum": [
                  "place",
                  "select",
                  "merge",
                  "upgrade"
                ]
              },
              "index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 15
              }
            },
            "required": [
              "action",
              "kind",
              "index"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 64
        }
      },
      "required": [
        "statePath",
        "width",
        "height",
        "cost",
        "damage",
        "range",
        "speed",
        "cooldownTicks",
        "maxTicks",
        "cells",
        "path",
        "waves",
        "actions"
      ],
      "additionalProperties": false
    },
    "stateSchema": {
      "type": "object"
    },
    "commands": [],
    "events": [
      {
        "name": "defense.placed",
        "payloadSchema": {
          "type": "object"
        }
      },
      {
        "name": "defense.changed",
        "payloadSchema": {
          "type": "object"
        }
      },
      {
        "name": "defense.invalid",
        "payloadSchema": {
          "type": "object"
        }
      },
      {
        "name": "defense.merged",
        "payloadSchema": {
          "type": "object"
        }
      },
      {
        "name": "defense.wave",
        "payloadSchema": {
          "type": "object"
        }
      },
      {
        "name": "defense.escaped",
        "payloadSchema": {
          "type": "object"
        }
      },
      {
        "name": "defense.fired",
        "payloadSchema": {
          "type": "object"
        }
      },
      {
        "name": "defense.reward",
        "payloadSchema": {
          "type": "object"
        }
      }
    ],
    "stateWrites": [
      "global"
    ],
    "lifecycle": [
      "initialize",
      "tick",
      "pause",
      "resume",
      "reset",
      "dispose"
    ]
  },
  "limits": {
    "maxTowers": 16,
    "maxEnemies": 32,
    "maxWaves": 32,
    "maxWaypoints": 64,
    "maxLevel": 8,
    "unitsPerMeter": 1000,
    "maxMovementPerTick": 128,
    "clock": "shared Tick; commands before combat rewards; merge inherits later cooldown; never reuse object IDs"
  },
  "testSuites": [
    "DEFENSE-OWNERSHIP-001",
    "COVERAGE-G21-POSITIVE",
    "COVERAGE-H01-POSITIVE"
  ]
}
