  "rules": [
    {
      "id": "match-reward",
      "on": {
        "type": "puzzle.changed"
      },
      "if": {
        "op": "and",
        "args": [
          {
            "state": "/puzzle/won"
          },
          {
            "op": "not",
            "args": [
              {
                "state": "/rewarded"
              }
            ]
          }
        ]
      },
      "do": [
        {
          "op": "state.add",
          "path": "/economy/wallet",
          "value": 3
        },
        {
          "op": "state.set",
          "path": "/rewarded",
          "value": true
        }
      ]
    }
  ],
  "outcomes": [
    {
      "id": "upgraded",
      "status": "won",
      "when": {
        "op": "and",
        "args": [
          {
            "state": "/puzzle/won"
          },
          {
            "op": "gte",
            "args": [
              {
                "state": "/economy/plots/0/level"
              },
              {
                "const": 1
              }
            ]
          }
        ]
      }
    }
  ],
