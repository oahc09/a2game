  "inputs": {
    "actions": [
      {
        "id": "charge",
        "valueType": "button",
        "bindings": [
          {
            "source": "keyboard.button",
            "config": {
              "code": "Space",
              "hold": true
            }
          },
          {
            "source": "touch.long-press",
            "config": {
              "minTicks": 2
            }
          }
        ]
      }
    ]
  },
  "rules": [
    {
      "id": "land-platform_b-true",
      "on": {
        "type": "realtime.landed"
      },
      "if": {
        "op": "and",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "event": "/surface"
              },
              {
                "const": "platform_b"
              }
            ]
          },
          {
            "op": "eq",
            "args": [
              {
                "state": "/jump/landings"
              },
              {
                "const": 0
              }
            ]
          },
          {
            "op": "and",
            "args": [
              {
                "op": "gte",
                "args": [
                  {
                    "event": "/centerOffset"
                  },
                  {
                    "const": -100
                  }
                ]
              },
              {
                "op": "lte",
                "args": [
                  {
                    "event": "/centerOffset"
                  },
                  {
                    "const": 100
                  }
                ]
              }
            ]
          }
        ]
      },
      "do": [
        {
          "op": "state.add",
          "path": "/jump/landings",
          "value": 1
        },
        {
          "op": "state.set",
          "path": "/jump/lastOffset",
          "value": {
            "event": "/centerOffset"
          }
        },
        {
          "op": "state.set",
          "path": "/jump/lastSurface",
          "value": "platform_b"
        },
        {
          "op": "state.add",
          "path": "/jump/combo",
          "value": 1
        },
        {
          "op": "state.set",
          "path": "/jump/bestCombo",
          "value": {
            "op": "max",
            "args": [
              {
                "state": "/jump/bestCombo"
              },
              {
                "op": "add",
                "args": [
                  {
                    "state": "/jump/combo"
                  },
                  {
                    "const": 1
                  }
                ]
              }
            ]
          }
        },
        {
          "op": "state.add",
          "path": "/jump/score",
          "value": {
            "op": "add",
            "args": [
              {
                "state": "/jump/combo"
              },
              {
                "const": 2
              }
            ]
          }
        }
      ]
    },
    {
      "id": "land-platform_b-false",
