                "statePath": "/world",
                "width": 8000,
                "height": 6000,
                "gravity": -4,
                "jumpSpeed": 96,
                "jumpHorizontalSpeed": 60,
                "platformLanding": true,
                "killBelowY": 600,
                "maxTicks": 480,
                "actions": {
