  "rules": [
    {
      "id": "start-timer",
      "on": {
        "type": "level.started"
      },
      "do": [
        {
          "op": "timer.schedule",
          "id": "deadline",
          "delayTicks": 4,
          "eventType": "level.timeout"
        },
        {
          "op": "timer.schedule",
          "id": "countdown",
          "delayTicks": 1,
          "periodTicks": 1,
          "eventType": "level.second"
        }
      ]
    },
    {
      "id": "time-expired",
      "on": {
        "type": "level.timeout"
      },
      "do": [
        {
          "op": "state.set",
          "path": "/timeout",
          "value": true
        }
      ]
    },
    {
      "id": "countdown",
      "on": {
        "type": "level.second"
      },
      "if": {
        "op": "gt",
        "args": [
          {
            "state": "/remaining"
          },
          {
            "const": 0
          }
        ]
      },
      "do": [
        {
          "op": "state.add",
          "path": "/remaining",
          "value": -1
        }
      ]
    },
    {
      "id": "apple-at-0",
      "on": {
        "type": "puzzle.changed"
      },
      "if": {
        "op": "eq",
        "args": [
