    "description": "移动并推动方块进入目标位置，非法移动不消耗步数。",
    "genres": [
      "puzzle"
    ]
  },
  "requires": {
    "all": [
      {
        "id": "a2game.core.state",
        "version": "0.1.0"
      },
      {
        "id": "a2game.core.rules",
        "version": "0.1.0"
      },
      {
        "id": "a2game.core.flow",
        "version": "0.1.0"
      },
      {
        "id": "a2game.input.keyboard.button",
        "version": "0.1.0"
      },
      {
        "id": "a2game.puzzle.grid-push",
        "version": "0.1.0"
      },
      {
        "id": "a2game.visual.scene2d",
