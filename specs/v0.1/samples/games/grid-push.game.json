    "actions": [
      {
        "id": "moveLeft",
        "valueType": "button",
        "policy": "first-ready",
        "bindings": [
          {
            "source": "keyboard.button",
            "config": {
              "code": "ArrowLeft"
            }
          },
          {
            "source": "touch.swipe",
            "config": {
              "direction": "left",
              "minDistanceNorm": 0.12,
              "maxDurationUs": 1200000
