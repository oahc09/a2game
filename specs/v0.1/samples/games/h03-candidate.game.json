  "inputs": {
    "actions": [
      {
        "id": "zones",
        "valueType": "pose",
        "bindings": [
          {
            "source": "touch.raw",
            "config": {}
          }
        ]
      }
    ]
  },
  "rules": [
    {
      "id": "left-zone",
      "on": {
        "type": "input.action",
        "action": "zones",
        "edge": "press"
      },
      "if": {
        "op": "and",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "event": "/value/kind"
              },
              {
                "const": "down"
              }
            ]
          },
          {
            "op": "lt",
            "args": [
              {
                "event": "/value/u"
              },
              {
                "const": 0.3
              }
            ]
          }
        ]
      },
      "do": [
        {
          "op": "state.set",
          "path": "/control/laneSignal",
          "value": -1
        }
      ]
    },
    {
      "id": "right-zone",
      "on": {
        "type": "input.action",
        "action": "zones",
        "edge": "press"
      },
      "if": {
        "op": "and",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "event": "/value/kind"
              },
              {
                "const": "down"
              }
            ]
          },
          {
            "op": "gt",
            "args": [
              {
                "event": "/value/u"
              },
              {
                "const": 0.7
              }
            ]
          }
        ]
      },
      "do": [
        {
          "op": "state.set",
          "path": "/control/fireRequest",
          "value": true
        }
      ]
    }
  ],
  "outcomes": [
    {
      "id": "won",
      "status": "won",
      "when": {
        "state": "/world/won"
      }
    },
    {
      "id": "lost",
      "status": "lost",
      "priority": -1,
      "when": {
        "state": "/world/lost"
      }
    }
  ],
