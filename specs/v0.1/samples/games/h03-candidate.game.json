              "capability": {
                "id": "a2game.realtime.world",
                "version": "0.1.0"
              },
              "config": {
                "statePath": "/world",
                "width": 8000,
                "height": 6000,
                "weapon": "hitscan",
                "fireDirection": "up",
                "fireRequestPath": "/control/fireRequest",
                "laneRequestPath": "/control/laneSignal",
                "laneWidth": 2000,
                "goalScore": 1,
