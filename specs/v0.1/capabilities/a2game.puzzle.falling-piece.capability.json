{
  "format": "a2game-capability",
  "manifestVersion": "0.1.0",
  "id": "a2game.puzzle.falling-piece",
  "version": "0.1.0",
  "kind": "behavior",
  "portability": "exact",
  "description": "Shared falling mechanism; transactional state proposals, legal-action checks, bounded undo and deterministic RNG.",
  "phase": "simulate",
  "dependencies": [
    {
      "id": "a2game.core.state",
      "version": "0.1.0"
    },
    {
      "id": "a2game.puzzle.grid",
      "version": "0.1.0"
    },
    {
      "id": "a2game.puzzle.undo",
      "version": "0.1.0"
    },
    {
      "id": "a2game.puzzle.polyomino",
      "version": "0.1.0"
    },
    {
      "id": "a2game.puzzle.rotate-piece",
      "version": "0.1.0"
    },
    {
      "id": "a2game.puzzle.line-clear",
      "version": "0.1.0"
    }
  ],
  "contract": {
    "configSchema": {
      "type": "object",
      "properties": {
        "statePath": {
          "type": "string",
          "pattern": "^/(?:[^~/]|~[01])+$"
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "selectActions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 256
        },
        "undoAction": {
          "type": "string",
          "minLength": 1
        },
        "targetScore": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "pieces": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3
              },
              "minItems": 2,
              "maxItems": 2
            },
            "maxItems": 16
          },
          "maxItems": 16
        },
        "rotateAction": {
          "type": "string",
          "minLength": 1
        },
        "leftAction": {
          "type": "string",
          "minLength": 1
        },
        "rightAction": {
          "type": "string",
          "minLength": 1
        },
        "dropAction": {
          "type": "string",
          "minLength": 1
        },
        "fallTicks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        }
      },
      "required": [
        "statePath",
        "width",
        "height",
        "selectActions"
      ],
      "additionalProperties": false
    },
    "stateSchema": {
      "type": "object"
    },
    "commands": [],
    "events": [
      {
        "name": "puzzle.changed",
        "payloadSchema": {
          "type": "object"
        }
      },
      {
        "name": "puzzle.invalid",
        "payloadSchema": {
          "type": "object"
        }
      },
      {
        "name": "puzzle.undone",
        "payloadSchema": {
          "type": "object"
        }
      }
    ],
    "stateWrites": [
      "global"
    ],
    "lifecycle": [
      "initialize",
      "tick",
      "pause",
      "resume",
      "reset",
      "dispose"
    ]
  },
  "limits": {
    "maxCells": 256,
    "maxHistory": 16,
    "maxCascadeWaves": 16,
    "pieceGridSize": 4,
    "maxPieceCells": 16,
    "undoScope": "single-behavior scene; whole-session snapshots for compositions"
  },
  "testSuites": [
    "PUZZLE-LIBRARY-001"
  ]
}
