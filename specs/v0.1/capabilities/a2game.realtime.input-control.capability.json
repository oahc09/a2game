{
  "format": "a2game-capability",
  "manifestVersion": "0.1.0",
  "id": "a2game.realtime.input-control",
  "version": "0.1.0",
  "kind": "behavior",
  "portability": "exact",
  "description": "Trusted declarative input controller: bounded drag/tilt movement, segment/AABB slicing, rotation/scale goals, slingshot requests, drops and balance moments.",
  "phase": "simulate",
  "dependencies": [
    {
      "id": "a2game.core.state",
      "version": "0.1.0"
    },
    {
      "id": "a2game.realtime.intersection",
      "version": "0.1.0"
    },
    {
      "id": "a2game.realtime.rotate",
      "version": "0.1.0"
    },
    {
      "id": "a2game.realtime.collision",
      "version": "0.1.0"
    },
    {
      "id": "a2game.realtime.balance",
      "version": "0.1.0"
    }
  ],
  "contract": {
    "configSchema": {
      "type": "object",
      "properties": {
        "statePath": {
          "type": "string",
          "pattern": "^/"
        },
        "worldPath": {
          "type": "string",
          "pattern": "^/"
        },
        "width": {
          "type": "integer",
          "minimum": 256,
          "maximum": 32000
        },
        "height": {
          "type": "integer",
          "minimum": 256,
          "maximum": 32000
        },
        "sceneWidth": {
          "type": "number",
          "minimum": 1,
          "maximum": 100
        },
        "sceneHeight": {
          "type": "number",
          "minimum": 1,
          "maximum": 100
        },
        "origin": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": -100,
            "maximum": 100
          },
          "minItems": 2,
          "maxItems": 2
        },
        "bodyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "moveMode": {
          "enum": [
            "none",
            "drag",
            "relative-drag",
            "tilt"
          ]
        },
        "speed": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "dragAction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "tiltAction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "orientationAction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "rotateAction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "pinchAction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "pathAction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "rawAction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "spawnAction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "spawnLimit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "spawnValue": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "spawnY": {
          "type": "integer",
          "minimum": 16,
          "maximum": 31984
        },
        "spawnHalfSize": {
          "type": "integer",
          "minimum": 16,
          "maximum": 1000
        },
        "axisFromDrag": {
          "type": "boolean"
        },
        "aimFromDrag": {
          "type": "boolean"
        },
        "slingshot": {
          "type": "boolean"
        },
        "balance": {
          "type": "boolean"
        },
        "balanceGoalTicks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 36000
        },
        "minBalancedBodies": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "failureAngle": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 3.1416
        },
        "targetAngle": {
          "type": "number",
          "minimum": -6.2832,
          "maximum": 6.2832
        },
        "targetScale": {
          "type": "number",
          "minimum": 0.125,
          "maximum": 8
        },
        "angleTolerance": {
          "type": "number",
          "minimum": 0.0001,
          "maximum": 1
        },
        "scaleTolerance": {
          "type": "number",
          "minimum": 0.0001,
          "maximum": 1
        },
        "hazardIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "maxItems": 64
        },
        "goalScore": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "clearLostImu": {
          "type": "boolean"
        },
        "cancelClearsPower": {
          "type": "boolean"
        }
      },
      "required": [
        "statePath",
        "worldPath",
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "stateSchema": {
      "type": "object",
      "description": "State at config.statePath. Initialize it explicitly before the first Tick. The example is the shared neutral initializer, including for relative-drag.",
      "required": [
        "angle",
        "scale",
        "power",
        "score",
        "spawned",
        "balanceTicks",
        "cutIds",
        "won",
        "lost",
        "grabbing",
        "hasTarget",
        "fireRequest",
        "axis",
        "aim",
        "grab",
        "target"
      ],
      "properties": {
        "angle": {
          "type": "number",
          "minimum": -10000,
          "maximum": 10000
        },
        "scale": {
          "type": "number",
          "minimum": 0.125,
          "maximum": 8
        },
        "power": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000
        },
        "spawned": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "balanceTicks": {
          "type": "integer",
          "minimum": 0
        },
        "cutIds": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "string"
          }
        },
        "won": {
          "type": "boolean"
        },
        "lost": {
          "type": "boolean"
        },
        "grabbing": {
          "type": "boolean"
        },
        "hasTarget": {
          "type": "boolean"
        },
        "fireRequest": {
          "type": "boolean"
        },
        "axis": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        },
        "aim": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        },
        "grab": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        },
        "target": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        },
        "dragPointer": {
          "type": "integer",
          "minimum": 0
        },
        "dragOffset": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        }
      },
      "dependentRequired": {
        "dragPointer": [
          "dragOffset"
        ]
      },
      "examples": [
        {
          "angle": 0,
          "scale": 1,
          "axis": [
            0,
            0
          ],
          "aim": [
            1,
            0
          ],
          "power": 0,
          "score": 0,
          "won": false,
          "lost": false,
          "cutIds": [],
          "spawned": 0,
          "grabbing": false,
          "grab": [
            0.5,
            0.5
          ],
          "target": [
            0,
            0
          ],
          "hasTarget": false,
          "rotateSource": "",
          "pinchSource": "",
          "angleBase": 0,
          "scaleBase": 1,
          "balanceTicks": 0,
          "fireRequest": false,
          "usedInput": false,
          "laneSignal": 0
        }
      ]
    },
    "commands": [],
    "events": [
      {
        "name": "control.changed",
        "payloadSchema": {
          "type": "object"
        }
      },
      {
        "name": "control.invalid",
        "payloadSchema": {
          "type": "object"
        }
      },
      {
        "name": "control.spawned",
        "payloadSchema": {
          "type": "object"
        }
      },
      {
        "name": "control.cut",
        "payloadSchema": {
          "type": "object"
        }
      },
      {
        "name": "control.failed",
        "payloadSchema": {
          "type": "object"
        }
      }
    ],
    "stateWrites": [
      "global"
    ],
    "lifecycle": [
      "initialize",
      "tick",
      "pause",
      "resume",
      "reset",
      "dispose"
    ]
  },
  "limits": {
    "maxObjects": 128,
    "maxCutLedger": 128,
    "maxSegmentPoints": 128,
    "quantization": 0.0001,
    "coordinateProfile": "scene2d-contain-v1; viewport aspect recorded in normalized input",
    "physics": "AABB translation and logical balance moment; no general angular rigid-body solver"
  },
  "testSuites": [
    "INPUT-CONTROL-001"
  ]
}
