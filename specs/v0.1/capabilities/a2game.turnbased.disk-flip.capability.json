{
  "format": "a2game-capability",
  "manifestVersion": "0.1.0",
  "id": "a2game.turnbased.disk-flip",
  "version": "0.1.0",
  "kind": "behavior",
  "portability": "exact",
  "phase": "simulate",
  "description": "Eight-direction disk capture, legal moves, automatic pass and final count.",
  "dependencies": [
    {
      "id": "a2game.core.state",
      "version": "0.1.0"
    }
  ],
  "contract": {
    "configSchema": {
      "type": "object",
      "properties": {
        "statePath": {
          "type": "string",
          "pattern": "^/"
        },
        "width": {
          "type": "integer",
          "minimum": 3,
          "maximum": 8
        },
        "height": {
          "type": "integer",
          "minimum": 3,
          "maximum": 8
        },
        "cells": {
          "type": "array",
          "minItems": 9,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        }
      },
      "required": [
        "statePath",
        "width",
        "height",
        "cells"
      ],
      "additionalProperties": false
    },
    "stateSchema": {
      "type": "object"
    },
    "commands": [],
    "events": [
      {
        "name": "disk-flip.invalid",
        "payloadSchema": {
          "type": "object"
        }
      },
      {
        "name": "disk-flip.placed",
        "payloadSchema": {
          "type": "object"
        }
      },
      {
        "name": "disk-flip.skip",
        "payloadSchema": {
          "type": "object"
        }
      },
      {
        "name": "disk-flip.ended",
        "payloadSchema": {
          "type": "object"
        }
      }
    ],
    "stateWrites": [
      "global"
    ],
    "lifecycle": [
      "initialize",
      "tick",
      "pause",
      "resume",
      "reset",
      "dispose"
    ]
  },
  "limits": {
    "maxCells": 64
  },
  "testSuites": [
    "local-coverage-v2-monsoon-disks"
  ]
}
