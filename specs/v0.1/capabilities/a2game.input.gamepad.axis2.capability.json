{
  "format": "a2game-capability",
  "manifestVersion": "0.1.0",
  "id": "a2game.input.gamepad.axis2",
  "version": "0.1.0",
  "kind": "recognizer",
  "portability": "exact",
  "phase": "recognize",
  "description": "Shared bounded normalized Gamepad axis2 recognizer; native API acquisition is a separate opt-in Host input profile.",
  "dependencies": [
    {
      "id": "a2game.core.state",
      "version": "0.1.0"
    }
  ],
  "contract": {
    "configSchema": {
      "type": "object",
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "xAxis": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "yAxis": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "deadZone": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.9
        },
        "deadZoneMode": {
          "const": "radial"
        },
        "mapping": {
          "const": "standard",
          "description": "Opt in to browser standard-mapping admission for this device index at the native host. All gamepad bindings for that index must agree. Normalized trace packets do not attest device layout."
        },
        "invertY": {
          "type": "boolean",
          "description": "Optional Y sign inversion after dead-zone filtering. For standard sticks, true converts browser negative-up axes to world positive-up. Default false."
        }
      },
      "required": [
        "xAxis",
        "yAxis"
      ],
      "additionalProperties": false
    },
    "stateSchema": {
      "type": "object"
    },
    "commands": [],
    "events": [
      {
        "name": "input.action",
        "payloadSchema": {
          "type": "object"
        }
      }
    ],
    "stateWrites": [],
    "lifecycle": [
      "initialize",
      "tick",
      "pause",
      "resume",
      "reset",
      "dispose"
    ]
  },
  "limits": {
    "maxDevices": 4,
    "maxButtons": 32,
    "maxAxes": 16,
    "axisQuantum": 0.0001,
    "valueType": "vec2",
    "disconnect": "release buttons and neutral axes; pause clears held cache"
  },
  "testSuites": [
    "GAMEPAD-001"
  ]
}
