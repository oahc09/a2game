{
  "format": "a2game-capability",
  "manifestVersion": "0.1.0",
  "id": "a2game.puzzle.push",
  "version": "0.1.0",
  "kind": "behavior",
  "portability": "exact",
  "description": "推箱子风格网格合法性、原子推动与目标格成功判定。 Bounded history and RNG restoration are available through historyPath/undoAction.",
  "phase": "simulate",
  "dependencies": [
    {
      "id": "a2game.core.state",
      "version": "0.1.0"
    },
    {
      "id": "a2game.puzzle.undo",
      "version": "0.1.0"
    }
  ],
  "contract": {
    "configSchema": {
      "type": "object",
      "required": [
        "width",
        "height",
        "wallsPath",
        "goalsPath",
        "boxesPath",
        "playerPath",
        "movesPath",
        "solvedPath",
        "actions"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 3,
          "maximum": 32
        },
        "height": {
          "type": "integer",
          "minimum": 3,
          "maximum": 32
        },
        "wallsPath": {
          "type": "string",
          "pattern": "^/"
        },
        "goalsPath": {
          "type": "string",
          "pattern": "^/"
        },
        "boxesPath": {
          "type": "string",
          "pattern": "^/"
        },
        "playerPath": {
          "type": "string",
          "pattern": "^/"
        },
        "movesPath": {
          "type": "string",
          "pattern": "^/"
        },
        "solvedPath": {
          "type": "string",
          "pattern": "^/"
        },
        "actions": {
          "type": "object",
          "required": [
            "left",
            "right",
            "up",
            "down"
          ],
          "properties": {
            "left": {
              "type": "string"
            },
            "right": {
              "type": "string"
            },
            "up": {
              "type": "string"
            },
            "down": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "historyPath": {
          "type": "string",
          "pattern": "^/(?:[^~/]|~[01])+$"
        },
        "undoAction": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "dependentRequired": {
        "historyPath": [
          "undoAction"
        ],
        "undoAction": [
          "historyPath"
        ]
      }
    },
    "stateSchema": {
      "type": "object"
    },
    "commands": [],
    "events": [
      {
        "name": "grid.player-moved",
        "payloadSchema": {
          "type": "object"
        }
      },
      {
        "name": "grid.box-pushed",
        "payloadSchema": {
          "type": "object"
        }
      },
      {
        "name": "puzzle.undone",
        "payloadSchema": {
          "type": "object"
        }
      }
    ],
    "stateWrites": [
      "global"
    ],
    "lifecycle": [
      "initialize",
      "tick",
      "reset",
      "dispose"
    ]
  },
  "testSuites": [
    "PUZZLE-UNDO-001"
  ]
}
