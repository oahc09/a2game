{
  "format": "a2game-capability",
  "manifestVersion": "0.1.0",
  "id": "a2game.turnbased.grid-tactics",
  "version": "0.1.0",
  "kind": "behavior",
  "portability": "exact",
  "phase": "simulate",
  "description": "Grid movement, adjacent attacks, action points, enemy retaliation and optional tactical card consumption.",
  "dependencies": [
    {
      "id": "a2game.core.state",
      "version": "0.1.0"
    }
  ],
  "contract": {
    "configSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "statePath": {
          "type": "string",
          "pattern": "^/"
        },
        "columns": {
          "type": "integer",
          "minimum": 2,
          "maximum": 12
        },
        "rows": {
          "type": "integer",
          "minimum": 2,
          "maximum": 12
        },
        "walls": {
          "type": "array",
          "maxItems": 142,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 143
          }
        },
        "maxAP": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "damage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "enemyDamage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "moveActions": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "endAction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "attackAction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "cardActions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "scoutAction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "statePath",
        "columns",
        "rows",
        "walls",
        "maxAP",
        "damage",
        "enemyDamage",
        "moveActions",
        "endAction"
      ],
      "oneOf": [
        {
          "required": [
            "attackAction"
          ]
        },
        {
          "required": [
            "cardActions"
          ]
        }
      ]
    },
    "stateSchema": {
      "type": "object"
    },
    "commands": [],
    "events": [
      {
        "name": "tactics.turn",
        "payloadSchema": {
          "type": "object"
        }
      },
      {
        "name": "tactics.selected",
        "payloadSchema": {
          "type": "object"
        }
      },
      {
        "name": "tactics.invalid",
        "payloadSchema": {
          "type": "object"
        }
      },
      {
        "name": "tactics.hit",
        "payloadSchema": {
          "type": "object"
        }
      },
      {
        "name": "tactics.moved",
        "payloadSchema": {
          "type": "object"
        }
      }
    ],
    "stateWrites": [
      "global"
    ],
    "lifecycle": [
      "initialize",
      "tick",
      "pause",
      "resume",
      "reset",
      "dispose"
    ]
  },
  "limits": {
    "maxRows": 12,
    "maxColumns": 12,
    "maxCards": 32,
    "maxHand": 8
  },
  "testSuites": [
    "local-coverage-v2-amber-crossing",
    "local-coverage-v2-wind-cards"
  ]
}
