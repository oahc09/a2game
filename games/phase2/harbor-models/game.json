{
  "format": "a2game",
  "specVersion": "0.1.0",
  "id": "org.a2game.phase2.harbor-models",
  "revision": 1,
  "meta": {
    "title": "港湾模型与动画",
    "description": "码头与仓库基础模型，Tick派生旋转与粒子。点击两次完成展示。",
    "genres": [
      "casual",
      "puzzle"
    ]
  },
  "requires": {
    "all": [
      {
        "id": "a2game.core.state",
        "version": "0.1.0"
      },
      {
        "id": "a2game.core.rules",
        "version": "0.1.0"
      },
      {
        "id": "a2game.core.flow",
        "version": "0.1.0"
      },
      {
        "id": "a2game.rules.state-add",
        "version": "0.1.0"
      },
      {
        "id": "a2game.visual.text",
        "version": "0.1.0"
      },
      {
        "id": "a2game.visual.scene2d",
        "version": "0.1.0"
      },
      {
        "id": "a2game.visual.stage",
        "version": "0.1.0"
      }
    ],
    "anyOf": [
      [
        {
          "id": "a2game.input.touch.tap",
          "version": "0.1.0"
        },
        {
          "id": "a2game.input.keyboard.button",
          "version": "0.1.0"
        }
      ]
    ]
  },
  "world": {
    "dimension": "3d",
    "coordinateSystem": "rh-y-up",
    "units": "meter",
    "clock": {
      "tickHz": 60,
      "seed": 42,
      "maxCatchUpTicks": 5
    }
  },
  "assets": {
    "chime": {
      "uri": "assets/creation-kit/merge-chord.wav",
      "type": "audio",
      "integrity": "sha256-UV8yFbXjum2NdE05oi/dowoPmt7xN21jhhVkkH3T0SA="
    }
  },
  "prototypes": {},
  "scenes": [
    {
      "id": "main",
      "entities": []
    }
  ],
  "entryScene": "main",
  "state": {
    "score": {
      "type": "int",
      "initial": 0
    },
    "goal": {
      "type": "int",
      "initial": 2
    }
  },
  "inputs": {
    "actions": [
      {
        "id": "collect",
        "valueType": "button",
        "policy": "first-ready",
        "bindings": [
          {
            "source": "touch.tap",
            "config": {
              "region": "playfield"
            }
          },
          {
            "source": "keyboard.button",
            "config": {
              "code": "Space"
            }
          }
        ]
      }
    ],
    "traceRecording": "disabled"
  },
  "rules": [
    {
      "id": "reward-on-press",
      "priority": 0,
      "on": {
        "type": "input.action",
        "action": "collect",
        "edge": "press"
      },
      "if": {
        "op": "lt",
        "args": [
          {
            "state": "/score"
          },
          {
            "state": "/goal"
          }
        ]
      },
      "do": [
        {
          "op": "state.add",
          "path": "/score",
          "value": 1
        }
      ]
    }
  ],
  "outcomes": [
    {
      "id": "all-collected",
      "status": "won",
      "priority": 0,
      "when": {
        "op": "gte",
        "args": [
          {
            "state": "/score"
          },
          {
            "state": "/goal"
          }
        ]
      }
    }
  ],
  "presentation": {
    "hud": [
      {
        "id": "scoreLabel",
        "kind": "text",
        "text": "点击屏幕得分",
        "bind": {
          "text": {
            "template": "Score: {0} / {1}",
            "args": [
              {
                "state": "/score"
              },
              {
                "state": "/goal"
              }
            ]
          }
        }
      }
    ],
    "cues": [],
    "scene2d": {
      "width": 12,
      "height": 12,
      "background": "#10222e",
      "nodes": [
        {
          "id": "title",
          "kind": "text",
          "at": [
            0,
            5.5
          ],
          "text": {
            "literal": "港湾模型 · Tick旋转与粒子"
          },
          "fontSize": 0.6,
          "fill": "#e7f2e9"
        },
        {
          "id": "hint",
          "kind": "text",
          "at": [
            0,
            -5.5
          ],
          "text": {
            "literal": "点击两次完成 · 原创 CC0"
