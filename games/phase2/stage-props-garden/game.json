  "meta": {
    "title": "林间小站 · 道具展示",
    "description": "按空格或点击“收集”两次，让小光球走到终点。这里展示树、岩石和货箱的组合模型。",
    "author": "Cindy native subagent original CC0 authoring preset; reference collect mechanic",
    "genres": [
      "casual"
    ]
  },
  "requires": {
    "all": [
      {
        "id": "a2game.core.state",
        "version": "0.1.0"
      },
      {
        "id": "a2game.core.rules",
        "version": "0.1.0"
      },
      {
        "id": "a2game.core.flow",
        "version": "0.1.0"
      },
