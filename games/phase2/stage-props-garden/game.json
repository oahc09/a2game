      },
      {
        "id": "a2game.visual.scene2d",
        "version": "0.1.0"
      },
      {
        "id": "a2game.visual.stage",
        "version": "0.1.0"
      }
    ],
    "anyOf": [
      [
        {
          "id": "a2game.input.touch.tap",
          "version": "0.1.0"
        },
        {
          "id": "a2game.input.keyboard.button",
          "version": "0.1.0"
        }
      ]
    ]
  },
  "world": {
    "dimension": "3d",
    "coordinateSystem": "rh-y-up",
    "units": "meter",
    "clock": {
      "tickHz": 60,
      "seed": 42,
      "maxCatchUpTicks": 5
    }
  },
  "assets": {},
  "prototypes": {},
  "scenes": [
    {
      "id": "main",
      "entities": []
    }
  ],
  "entryScene": "main",
  "state": {
    "score": {
      "type": "int",
      "initial": 0
    },
    "goal": {
      "type": "int",
      "initial": 2
    }
  },
  "inputs": {
    "actions": [
      {
        "id": "collect",
        "valueType": "button",
        "policy": "first-ready",
        "bindings": [
          {
            "source": "touch.tap",
            "config": {
              "region": "playfield"
            }
          },
          {
            "source": "keyboard.button",
            "config": {
              "code": "Space"
            }
          }
        ]
      }
    ],
    "traceRecording": "disabled"
  },
  "rules": [
    {
      "id": "reward-on-press",
      "priority": 0,
      "on": {
        "type": "input.action",
        "action": "collect",
        "edge": "press"
      },
      "if": {
        "op": "lt",
        "args": [
          {
            "state": "/score"
          },
          {
            "state": "/goal"
          }
        ]
      },
      "do": [
        {
          "op": "state.add",
          "path": "/score",
          "value": 1
        }
      ]
    }
  ],
  "outcomes": [
    {
      "id": "all-collected",
      "status": "won",
      "priority": 0,
      "when": {
        "op": "gte",
        "args": [
          {
            "state": "/score"
          },
          {
            "state": "/goal"
          }
        ]
      }
    }
  ],
  "presentation": {
    "hud": [
      {
        "id": "score",
        "kind": "text",
        "text": "已收集",
        "bind": {
          "text": {
            "template": "已收集 {0} / {1}",
            "args": [
              {
                "state": "/score"
              },
              {
                "state": "/goal"
              }
            ]
          }
        }
      },
      {
        "id": "collect-label",
        "kind": "button",
        "text": "收集",
        "bind": {
          "action": "collect"
        }
      }
    ],
