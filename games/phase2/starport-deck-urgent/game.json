  "rules": [
    {
      "id": "draw-hint",
      "on": {
        "type": "input.action",
        "action": "drawCard",
        "edge": "press"
      },
      "do": [
        {
          "op": "state.set",
          "path": "/message",
          "value": "手牌最多3张；满手或空库时抽牌无变化"
        }
      ]
    },
    {
      "id": "drawn",
      "on": {
        "type": "cards.drawn"
      },
      "do": [
        {
          "op": "state.add",
          "path": "/deckCount",
          "value": -1
        },
        {
          "op": "state.add",
          "path": "/handCount",
          "value": 1
        },
        {
          "op": "state.set",
          "path": "/message",
          "value": "抽牌成功，数字键按位置出牌"
        }
      ]
    },
    {
      "id": "played-count",
      "priority": 0,
      "on": {
        "type": "cards.played"
      },
      "do": [
        {
          "op": "state.add",
          "path": "/handCount",
          "value": -1
        },
        {
          "op": "state.add",
          "path": "/discardCount",
          "value": 1
        },
        {
          "op": "state.add",
          "path": "/turns",
          "value": 1
        }
      ]
    },
    {
      "id": "empty-slot-1",
      "on": {
        "type": "input.action",
        "action": "slot1",
        "edge": "press"
      },
      "do": [
        {
          "op": "state.set",
          "path": "/message",
          "value": "该位置没有牌；先抽牌或选其他位置"
        }
      ]
    },
    {
      "id": "empty-slot-2",
      "on": {
        "type": "input.action",
        "action": "slot2",
        "edge": "press"
      },
      "do": [
        {
          "op": "state.set",
          "path": "/message",
          "value": "该位置没有牌；先抽牌或选其他位置"
        }
      ]
    },
    {
      "id": "empty-slot-3",
      "on": {
        "type": "input.action",
        "action": "slot3",
        "edge": "press"
      },
      "do": [
        {
          "op": "state.set",
          "path": "/message",
          "value": "该位置没有牌；先抽牌或选其他位置"
        }
      ]
    },
    {
      "id": "effect-1",
      "priority": 10,
      "on": {
        "type": "cards.played"
      },
      "if": {
        "op": "eq",
        "args": [
          {
            "event": "/card"
          },
          {
            "const": 1
          }
        ]
      },
      "do": [
        {
          "op": "state.add",
          "path": "/energy",
          "value": 2
        },
        {
          "op": "state.add",
          "path": "/heat",
          "value": 1
        },
        {
          "op": "state.set",
          "path": "/message",
          "value": "充能：电+2，热+1"
        }
      ]
    },
    {
      "id": "effect-2",
      "priority": 10,
      "on": {
        "type": "cards.played"
      },
      "if": {
        "op": "eq",
        "args": [
          {
            "event": "/card"
          },
          {
            "const": 2
          }
        ]
      },
      "do": [
        {
          "op": "state.add",
          "path": "/energy",
          "value": -1
        },
        {
          "op": "state.add",
          "path": "/ore",
          "value": 2
        },
        {
          "op": "state.add",
          "path": "/heat",
          "value": 1
        },
        {
          "op": "state.set",
          "path": "/message",
          "value": "采矿：电-1，矿+2，热+1"
        }
      ]
    },
    {
      "id": "effect-3",
      "priority": 10,
      "on": {
        "type": "cards.played"
      },
      "if": {
        "op": "eq",
        "args": [
          {
            "event": "/card"
          },
          {
            "const": 3
          }
        ]
      },
      "do": [
        {
          "op": "state.add",
          "path": "/energy",
          "value": -1
        },
        {
          "op": "state.add",
          "path": "/ore",
          "value": -2
        },
        {
          "op": "state.add",
          "path": "/orders",
          "value": 1
        },
        {
          "op": "state.add",
          "path": "/heat",
          "value": 1
        },
        {
          "op": "state.set",
          "path": "/message",
          "value": "装配：电-1矿-2，交付+1"
        }
      ]
    },
    {
      "id": "effect-4",
      "priority": 10,
      "on": {
        "type": "cards.played"
      },
      "if": {
        "op": "eq",
        "args": [
          {
            "event": "/card"
          },
          {
            "const": 4
          }
        ]
      },
      "do": [
        {
          "op": "state.add",
          "path": "/heat",
          "value": -3
        },
        {
          "op": "state.clamp",
          "path": "/heat",
          "min": 0,
          "max": 99
        },
        {
          "op": "state.set",
          "path": "/message",
          "value": "冷却：热-3，最低0"
        }
      ]
    }
  ],
