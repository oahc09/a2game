  "rules": [
    {
      "id": "refine",
      "on": {
        "type": "input.action",
        "action": "refine",
        "edge": "press"
      },
      "if": {
        "op": "and",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "state": "/busy"
              },
              {
                "const": false
              }
            ]
          },
          {
            "op": "eq",
            "args": [
              {
                "state": "/ready"
              },
              {
                "const": false
              }
            ]
          },
          {
            "op": "gt",
            "args": [
              {
                "state": "/ore"
              },
              {
                "const": 0
              }
            ]
          }
        ]
      },
      "do": [
        {
          "op": "state.add",
          "path": "/ore",
          "value": -1
        },
        {
          "op": "state.set",
          "path": "/busy",
          "value": true
        },
        {
          "op": "state.set",
          "path": "/due",
          "value": {
            "op": "add",
            "args": [
              {
                "state": "/clock"
              },
              {
                "const": 120
              }
            ]
          }
        },
        {
          "op": "state.set",
          "path": "/forge",
          "value": "熔炼中"
        },
        {
          "op": "state.set",
          "path": "/message",
          "value": "熔炼约2秒，成熟后 H 收取"
        }
      ]
    },
    {
      "id": "refine-invalid",
      "on": {
        "type": "input.action",
        "action": "refine",
        "edge": "press"
      },
      "if": {
        "op": "or",
        "args": [
          {
