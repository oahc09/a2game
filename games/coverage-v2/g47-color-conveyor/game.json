          "op": "state.set",
          "path": "/running",
          "value": true
        },
        {
          "op": "state.set",
          "path": "/next",
          "value": {
            "op": "add",
            "args": [
              {
                "state": "/clock"
              },
              {
                "const": 20
              }
            ]
          }
        }
      ]
    },
