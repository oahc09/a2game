  "rules": [
    {
      "id": "route-red",
      "on": {
        "type": "input.action",
        "action": "red",
        "edge": "press"
      },
      "do": [
        {
          "op": "state.set",
          "path": "/mode",
          "value": 1
        }
      ]
    },
    {
      "id": "route-blue",
      "on": {
        "type": "input.action",
        "action": "blue",
        "edge": "press"
      },
      "do": [
        {
          "op": "state.set",
          "path": "/mode",
          "value": 2
        }
      ]
    },
    {
      "id": "empty",
      "on": {
        "type": "input.action",
        "action": "pack",
        "edge": "press"
      },
      "if": {
        "op": "eq",
        "args": [
          {
            "state": "/running"
          },
          {
            "const": false
          }
        ]
      },
      "do": [
        {
          "op": "state.set",
          "path": "/wantEmpty",
          "value": true
        }
      ]
    },
    {
      "id": "pack",
      "on": {
        "type": "level.tick"
      },
      "if": {
        "op": "eq",
        "args": [
          {
            "state": "/wantEmpty"
          },
          {
            "const": true
          }
        ]
      },
      "do": [
        {
          "op": "state.add",
          "path": "/packed",
          "value": {
            "op": "add",
            "args": [
              {
                "state": "/red"
              },
              {
                "state": "/blue"
              }
            ]
          }
        },
        {
          "op": "state.set",
          "path": "/red",
          "value": 0
        },
        {
          "op": "state.set",
          "path": "/blue",
          "value": 0
        },
        {
          "op": "state.set",
          "path": "/wantEmpty",
          "value": false
        }
      ]
    },
    {
      "id": "run",
      "on": {
        "type": "input.action",
        "action": "toggle",
        "edge": "press"
      },
      "if": {
        "op": "eq",
