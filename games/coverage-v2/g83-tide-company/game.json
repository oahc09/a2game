            }
          }
        ]
      }
    ]
  },
  "rules": [
    {
      "id": "swap",
      "on": {
        "type": "input.action",
        "action": "swap",
        "edge": "press"
      },
      "do": [
        {
          "op": "state.set",
          "path": "/front",
          "value": {
            "op": "sub",
            "args": [
              {
                "const": 1
              },
              {
                "state": "/front"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "shield",
      "on": {
        "type": "input.action",
        "action": "fight",
        "edge": "press"
      },
      "if": {
        "op": "eq",
        "args": [
          {
            "state": "/front"
          },
          {
            "const": 1
          }
        ]
      },
      "do": [
        {
          "op": "state.set",
          "path": "/hp",
          "value": {
            "op": "max",
            "args": [
              {
                "const": 0
              },
              {
                "op": "sub",
                "args": [
                  {
                    "state": "/hp"
                  },
                  {
                    "op": "add",
                    "args": [
                      {
                        "const": 2
                      },
                      {
                        "state": "/trained"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        },
        {
          "op": "state.add",
          "path": "/xp",
          "value": 1
        }
      ]
    },
    {
      "id": "ranger",
      "on": {
        "type": "input.action",
        "action": "fight",
        "edge": "press"
      },
      "if": {
        "op": "and",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "state": "/front"
              },
              {
                "const": 0
              }
            ]
          },
          {
            "op": "gte",
            "args": [
              {
                "state": "/life"
              },
              {
                "const": 1
              }
            ]
          }
        ]
      },
      "do": [
        {
          "op": "state.set",
          "path": "/hp",
          "value": {
            "op": "max",
            "args": [
              {
                "const": 0
              },
              {
                "op": "sub",
                "args": [
                  {
                    "state": "/hp"
                  },
                  {
                    "const": 1
                  }
                ]
              }
            ]
          }
        },
        {
          "op": "state.add",
          "path": "/life",
          "value": -1
        },
        {
          "op": "state.add",
          "path": "/xp",
          "value": 1
        }
      ]
    },
    {
      "id": "train",
      "on": {
        "type": "input.action",
        "action": "train",
        "edge": "press"
      },
      "if": {
        "op": "and",
        "args": [
          {
            "op": "gte",
            "args": [
              {
                "state": "/xp"
              },
              {
                "const": 1
              }
            ]
          },
          {
            "op": "eq",
            "args": [
              {
                "state": "/trained"
              },
              {
                "const": 0
              }
            ]
          }
        ]
      },
      "do": [
        {
          "op": "state.add",
          "path": "/xp",
          "value": -1
        },
        {
          "op": "state.set",
          "path": "/trained",
          "value": 1
        }
      ]
    }
  ],
