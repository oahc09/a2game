{
  "format": "a2game",
  "specVersion": "0.1.0",
  "id": "local.coverage-v2.river-clock",
  "revision": 1,
  "meta": {
    "title": "潮站时间线",
    "description": "调查登记簿与潮位计，排定停船与警铃的顺序。",
    "genres": [
      "puzzle"
    ]
  },
  "requires": {
    "all": [
      {
        "id": "a2game.core.state",
        "version": "0.1.0"
      },
      {
        "id": "a2game.core.rules",
        "version": "0.1.0"
      },
      {
        "id": "a2game.core.flow",
        "version": "0.1.0"
      },
      {
        "id": "a2game.rules.state-set",
        "version": "0.1.0"
      },
      {
        "id": "a2game.input.keyboard.button",
        "version": "0.1.0"
      },
      {
        "id": "a2game.visual.text",
        "version": "0.1.0"
      },
      {
        "id": "a2game.visual.scene2d",
        "version": "0.1.0"
      },
      {
        "id": "a2game.rules.state-add",
        "version": "0.1.0"
      },
      {
        "id": "a2game.core.bootstrap",
        "version": "0.1.0"
      },
      {
        "id": "a2game.core.clock",
        "version": "0.1.0"
      }
    ]
  },
  "world": {
    "dimension": "2d",
    "coordinateSystem": "rh-y-up",
    "units": "meter",
    "clock": {
      "tickHz": 60,
      "seed": 12122,
      "maxCatchUpTicks": 5
    }
  },
  "assets": {},
  "prototypes": {},
  "scenes": [
    {
      "id": "main",
      "entities": []
    }
  ],
  "entryScene": "main",
  "state": {
    "register": {
      "type": "int",
      "initial": 0
    },
    "gauge": {
      "type": "int",
      "initial": 0
    },
    "first": {
      "type": "int",
      "initial": 0
    },
    "second": {
      "type": "int",
      "initial": 0
    },
    "done": {
      "type": "int",
      "initial": 0
    },
    "message": {
      "type": "string",
      "initial": "先搜证物，再确认时间线"
    }
  },
  "inputs": {
    "actions": [
      {
        "id": "register",
        "valueType": "button",
        "bindings": [
          {
            "source": "keyboard.button",
            "config": {
              "code": "Digit1",
              "hold": false
            }
          }
        ]
      },
      {
        "id": "gauge",
        "valueType": "button",
        "bindings": [
          {
            "source": "keyboard.button",
            "config": {
              "code": "Digit2",
              "hold": false
            }
          }
        ]
      },
      {
        "id": "bell",
        "valueType": "button",
        "bindings": [
          {
            "source": "keyboard.button",
            "config": {
              "code": "Digit3",
              "hold": false
            }
          }
        ]
      },
      {
        "id": "stop",
        "valueType": "button",
        "bindings": [
          {
            "source": "keyboard.button",
            "config": {
              "code": "Digit4",
              "hold": false
            }
          }
        ]
      },
      {
        "id": "submit",
        "valueType": "button",
        "bindings": [
          {
            "source": "keyboard.button",
            "config": {
              "code": "Digit5",
              "hold": false
            }
          }
        ]
      },
      {
        "id": "clear",
        "valueType": "button",
        "bindings": [
          {
            "source": "keyboard.button",
            "config": {
              "code": "Digit6",
              "hold": false
            }
          }
        ]
      }
    ]
  },
  "rules": [
    {
      "id": "register",
      "on": {
        "type": "input.action",
        "action": "register",
        "edge": "press"
      },
      "do": [
        {
          "op": "state.set",
          "path": "/register",
          "value": 8
        },
        {
          "op": "state.set",
          "path": "/message",
          "value": "登记簿：08 时停船"
        }
      ]
    },
    {
      "id": "gauge",
      "on": {
        "type": "input.action",
        "action": "gauge",
        "edge": "press"
      },
      "do": [
        {
          "op": "state.set",
          "path": "/gauge",
          "value": 9
        },
        {
          "op": "state.set",
          "path": "/message",
          "value": "潮位计：09 时警铃"
        }
      ]
    },
    {
      "id": "first-bell",
      "on": {
        "type": "input.action",
        "action": "bell",
        "edge": "press"
      },
      "if": {
        "op": "eq",
        "args": [
          {
            "state": "/first"
          },
          {
            "const": 0
          }
        ]
      },
      "do": [
        {
          "op": "state.set",
          "path": "/first",
          "value": 2
        },
        {
          "op": "state.set",
          "path": "/message",
          "value": "第一事件：警铃"
        }
      ]
    },
    {
      "id": "second-bell",
      "on": {
        "type": "input.action",
        "action": "bell",
        "edge": "press"
      },
      "if": {
        "op": "gt",
        "args": [
          {
            "state": "/first"
          },
          {
            "const": 0
          }
        ]
      },
      "do": [
        {
          "op": "state.set",
          "path": "/second",
          "value": 2
        },
        {
          "op": "state.set",
          "path": "/message",
          "value": "第二事件：警铃"
        }
      ]
    },
    {
      "id": "first-stop",
      "on": {
        "type": "input.action",
        "action": "stop",
        "edge": "press"
      },
      "if": {
        "op": "eq",
        "args": [
          {
            "state": "/first"
          },
          {
            "const": 0
          }
        ]
      },
      "do": [
        {
          "op": "state.set",
          "path": "/first",
          "value": 1
        },
        {
          "op": "state.set",
          "path": "/message",
          "value": "第一事件：停船"
        }
      ]
    },
    {
      "id": "second-stop",
      "on": {
        "type": "input.action",
        "action": "stop",
        "edge": "press"
      },
      "if": {
        "op": "gt",
        "args": [
          {
            "state": "/first"
          },
          {
            "const": 0
          }
        ]
      },
      "do": [
        {
          "op": "state.set",
          "path": "/second",
          "value": 1
        },
        {
          "op": "state.set",
          "path": "/message",
          "value": "第二事件：停船"
        }
      ]
    },
    {
      "id": "verify",
      "on": {
        "type": "input.action",
        "action": "submit",
        "edge": "press"
      },
      "if": {
        "op": "and",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "state": "/register"
              },
              {
                "const": 8
              }
            ]
          },
          {
            "op": "eq",
            "args": [
              {
                "state": "/gauge"
              },
              {
                "const": 9
              }
            ]
          },
          {
            "op": "eq",
            "args": [
              {
                "state": "/first"
              },
              {
                "const": 1
              }
            ]
          },
          {
            "op": "eq",
            "args": [
              {
                "state": "/second"
              },
              {
                "const": 2
              }
            ]
          }
        ]
      },
      "do": [
        {
          "op": "state.set",
          "path": "/done",
          "value": 1
        },
        {
          "op": "state.set",
          "path": "/message",
          "value": "时间线核对成功"
        }
      ]
    },
    {
      "id": "clear",
      "on": {
        "type": "input.action",
        "action": "clear",
        "edge": "press"
      },
      "do": [
        {
          "op": "state.set",
          "path": "/first",
          "value": 0
        },
        {
          "op": "state.set",
          "path": "/second",
          "value": 0
        },
        {
          "op": "state.set",
          "path": "/message",
          "value": "时间线已清空"
        }
      ]
    }
  ],
  "outcomes": [
    {
      "id": "success",
      "priority": 0,
      "status": "won",
      "when": {
        "op": "eq",
        "args": [
          {
            "state": "/done"
          },
          {
            "const": 1
          }
        ]
      }
    }
  ],
  "presentation": {
    "hud": [
      {
        "id": "button-register",
        "kind": "button",
        "text": "1 读登记簿",
        "bind": {
          "action": "register"
        }
      },
      {
        "id": "button-gauge",
        "kind": "button",
        "text": "2 读潮位计",
        "bind": {
          "action": "gauge"
        }
      },
      {
        "id": "button-bell",
        "kind": "button",
        "text": "3 放置警铃",
        "bind": {
          "action": "bell"
        }
      },
      {
        "id": "button-stop",
        "kind": "button",
        "text": "4 放置停船",
        "bind": {
          "action": "stop"
        }
      },
      {
        "id": "button-submit",
        "kind": "button",
        "text": "5 提交时间线",
        "bind": {
          "action": "submit"
        }
      },
      {
        "id": "button-clear",
        "kind": "button",
        "text": "6 清空时间线",
        "bind": {
          "action": "clear"
        }
      }
    ],
