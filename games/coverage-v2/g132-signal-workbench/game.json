              "hold": false
            }
          }
        ]
      }
    ]
  },
  "rules": [
    {
      "id": "toggle-source",
      "on": {
        "type": "input.action",
        "action": "source",
        "edge": "press"
      },
      "do": [
        {
          "op": "state.set",
          "path": "/source",
          "value": {
            "op": "eq",
            "args": [
              {
                "state": "/source"
              },
              {
                "const": false
              }
            ]
          }
        }
      ]
    },
    {
      "id": "toggle-bridge",
      "on": {
        "type": "input.action",
        "action": "bridge",
        "edge": "press"
      },
      "do": [
        {
          "op": "state.set",
          "path": "/bridge",
          "value": {
            "op": "eq",
            "args": [
              {
                "state": "/bridge"
              },
              {
                "const": false
              }
            ]
          }
        }
      ]
    },
    {
      "id": "toggle-interlock",
      "on": {
        "type": "input.action",
        "action": "interlock",
        "edge": "press"
      },
      "do": [
        {
          "op": "state.set",
          "path": "/interlock",
          "value": {
            "op": "eq",
            "args": [
              {
                "state": "/interlock"
              },
              {
                "const": false
              }
            ]
          }
        }
      ]
    },
    {
      "id": "evaluate-network",
      "on": {
        "type": "level.tick"
      },
      "do": [
        {
          "op": "state.set",
          "path": "/live",
          "value": {
            "op": "eq",
            "args": [
              {
                "state": "/source"
              },
              {
                "const": true
              }
            ]
          }
        },
        {
          "op": "state.set",
          "path": "/relayed",
          "value": {
            "op": "and",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "state": "/source"
                  },
                  {
                    "const": true
                  }
                ]
              },
              {
                "op": "eq",
                "args": [
                  {
                    "state": "/bridge"
                  },
                  {
                    "const": true
                  }
                ]
              }
            ]
          }
        },
        {
          "op": "state.set",
          "path": "/driven",
          "value": {
            "op": "and",
            "args": [
              {
                "op": "and",
                "args": [
                  {
                    "op": "eq",
                    "args": [
                      {
                        "state": "/source"
                      },
                      {
                        "const": true
                      }
                    ]
                  },
                  {
                    "op": "eq",
                    "args": [
                      {
                        "state": "/bridge"
                      },
                      {
                        "const": true
                      }
                    ]
                  }
                ]
              },
              {
                "op": "eq",
                "args": [
                  {
                    "state": "/interlock"
                  },
                  {
                    "const": false
                  }
                ]
              }
            ]
          }
        }
      ]
    }
  ],
