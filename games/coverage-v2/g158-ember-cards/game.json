{
  "format": "a2game",
  "specVersion": "0.1.0",
  "id": "local.coverage-v2.ember-cards",
  "revision": 1,
  "meta": {
    "title": "余烬对牌",
    "description": "抽取牌，支付能量攻击。用休整回能，击败对手。",
    "genres": [
      "strategy"
    ]
  },
  "requires": {
    "all": [
      {
        "id": "a2game.core.state",
        "version": "0.1.0"
      },
      {
        "id": "a2game.core.rules",
        "version": "0.1.0"
      },
      {
        "id": "a2game.core.flow",
        "version": "0.1.0"
      },
      {
        "id": "a2game.rules.state-set",
        "version": "0.1.0"
      },
      {
        "id": "a2game.input.keyboard.button",
        "version": "0.1.0"
      },
      {
        "id": "a2game.visual.text",
        "version": "0.1.0"
      },
      {
        "id": "a2game.visual.scene2d",
        "version": "0.1.0"
      },
      {
        "id": "a2game.rules.state-add",
        "version": "0.1.0"
