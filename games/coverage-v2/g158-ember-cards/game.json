  "world": {
    "dimension": "2d",
    "coordinateSystem": "rh-y-up",
    "units": "meter",
    "clock": {
      "tickHz": 60,
      "seed": 12122,
      "maxCatchUpTicks": 5
    }
  },
  "assets": {},
  "prototypes": {},
  "scenes": [
    {
      "id": "main",
      "entities": []
    }
  ],
  "entryScene": "main",
  "state": {
    "energy": {
      "type": "int",
      "initial": 2
    },
    "opponent": {
      "type": "int",
      "initial": 3
    },
    "hand": {
      "type": "int",
      "initial": 0
    },
    "deck": {
      "type": "int",
      "initial": 2
    },
    "stage": {
      "type": "int",
      "initial": 1
    },
    "reward": {
      "type": "int",
      "initial": 0
    },
    "message": {
      "type": "string",
      "initial": "先按 1 抽牌"
    }
  },
  "inputs": {
    "actions": [
      {
        "id": "draw",
        "valueType": "button",
        "bindings": [
          {
            "source": "keyboard.button",
            "config": {
              "code": "Digit1",
              "hold": false
            }
          }
        ]
      },
      {
        "id": "strike",
        "valueType": "button",
        "bindings": [
          {
            "source": "keyboard.button",
            "config": {
              "code": "Digit2",
              "hold": false
            }
          }
        ]
      },
      {
        "id": "recover",
        "valueType": "button",
        "bindings": [
          {
            "source": "keyboard.button",
            "config": {
              "code": "Digit3",
              "hold": false
            }
          }
        ]
      }
    ]
  },
  "rules": [
    {
      "id": "draw",
      "on": {
        "type": "input.action",
        "action": "draw",
        "edge": "press"
      },
      "if": {
        "op": "and",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "state": "/hand"
              },
              {
                "const": 0
              }
            ]
          },
          {
            "op": "gte",
            "args": [
              {
                "state": "/deck"
              },
              {
                "const": 1
              }
            ]
          },
          {
            "op": "gte",
            "args": [
              {
                "state": "/opponent"
              },
              {
                "const": 1
              }
            ]
          }
        ]
      },
      "do": [
        {
          "op": "state.add",
          "path": "/deck",
          "value": -1
        },
        {
          "op": "state.set",
          "path": "/hand",
          "value": {
            "op": "add",
            "args": [
              {
                "state": "/reward"
              },
              {
                "const": 1
              }
            ]
          }
        },
        {
          "op": "state.set",
          "path": "/message",
          "value": "手牌就绪"
        }
      ]
    },
    {
      "id": "recover",
      "on": {
        "type": "input.action",
        "action": "recover",
        "edge": "press"
      },
      "if": {
        "op": "lt",
        "args": [
          {
            "state": "/energy"
          },
          {
            "const": 2
          }
        ]
      },
      "do": [
        {
          "op": "state.set",
          "path": "/energy",
          "value": 2
        },
        {
          "op": "state.set",
          "path": "/message",
          "value": "能量回到 2"
        }
      ]
    },
    {
      "id": "play-1",
      "on": {
        "type": "input.action",
        "action": "strike",
        "edge": "press"
      },
      "if": {
        "op": "and",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "state": "/hand"
              },
              {
                "const": 1
              }
            ]
          },
          {
            "op": "gte",
            "args": [
              {
                "state": "/energy"
              },
              {
                "const": 2
              }
            ]
          },
          {
            "op": "gte",
            "args": [
              {
                "state": "/opponent"
              },
              {
                "const": 1
              }
            ]
          }
        ]
      },
      "do": [
        {
          "op": "state.add",
          "path": "/energy",
          "value": -2
        },
        {
          "op": "state.set",
          "path": "/hand",
          "value": 0
        },
        {
          "op": "state.set",
          "path": "/opponent",
          "value": {
            "op": "max",
            "args": [
              {
                "const": 0
              },
              {
                "op": "sub",
                "args": [
                  {
                    "state": "/opponent"
                  },
                  {
                    "const": 2
                  }
                ]
              }
            ]
          }
        },
        {
          "op": "state.set",
          "path": "/message",
          "value": "支付能量 · 卡牌命中"
        }
      ]
    },
