    "line2": {
      "type": "string",
      "initial": "外海货轮和湾内渔艇同时求援。"
    },
    "choiceA": {
      "type": "string",
      "initial": "A · 照向外海航标"
    },
    "choiceB": {
      "type": "string",
      "initial": "B · 照向湾内浅滩"
    },
