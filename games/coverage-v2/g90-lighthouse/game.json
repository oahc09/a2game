        "id": "chooseA",
        "valueType": "button",
        "bindings": [
          {
            "source": "keyboard.button",
            "config": {
              "code": "KeyA",
              "hold": false
            }
          }
        ]
      },
      {
        "id": "chooseB",
        "valueType": "button",
        "bindings": [
          {
            "source": "keyboard.button",
            "config": {
              "code": "KeyB",
              "hold": false
            }
          }
        ]
      }
    ]
