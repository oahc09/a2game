        },
        {
          "id": "message",
          "kind": "text",
          "at": [
            0,
            -2.75
          ],
          "text": {
            "state": "/message"
          },
          "fontSize": 0.4,
          "fill": "#F6DEAD"
        }
      ]
    }
  },
  "tests": [
    "conformance.json"
  ],
  "extensions": {}
}
