{
  "format": "a2game",
  "specVersion": "0.1.0",
  "id": "local.coverage-v2.banner-zones",
  "revision": 1,
  "meta": {
    "title": "双旗领地",
    "description": "1、2 在区域部署旗帜，3 结算回合。已占区域不能被重复占领。",
    "genres": [
      "strategy"
    ]
  },
  "requires": {
    "all": [
      {
        "id": "a2game.core.state",
        "version": "0.1.0"
      },
      {
        "id": "a2game.core.rules",
        "version": "0.1.0"
      },
      {
        "id": "a2game.core.flow",
        "version": "0.1.0"
      },
      {
        "id": "a2game.rules.state-set",
        "version": "0.1.0"
      },
      {
        "id": "a2game.input.keyboard.button",
        "version": "0.1.0"
      },
      {
        "id": "a2game.visual.text",
        "version": "0.1.0"
      },
      {
        "id": "a2game.visual.scene2d",
        "version": "0.1.0"
      },
      {
        "id": "a2game.rules.state-add",
        "version": "0.1.0"
      },
      {
        "id": "a2game.core.bootstrap",
        "version": "0.1.0"
      },
      {
        "id": "a2game.core.clock",
        "version": "0.1.0"
      }
    ]
  },
  "world": {
    "dimension": "2d",
    "coordinateSystem": "rh-y-up",
    "units": "meter",
    "clock": {
      "tickHz": 60,
      "seed": 12122,
      "maxCatchUpTicks": 5
    }
  },
  "assets": {},
  "prototypes": {},
  "scenes": [
    {
      "id": "main",
      "entities": []
    }
  ],
  "entryScene": "main",
  "state": {
    "north": {
      "type": "int",
      "initial": 0
    },
    "south": {
      "type": "int",
      "initial": 0
    },
    "player": {
      "type": "int",
      "initial": 1
    },
    "red": {
      "type": "int",
      "initial": 0
    },
    "blue": {
      "type": "int",
      "initial": 0
    },
    "turns": {
      "type": "int",
      "initial": 0
    }
  },
  "inputs": {
    "actions": [
      {
        "id": "upper",
        "valueType": "button",
        "bindings": [
          {
            "source": "keyboard.button",
            "config": {
              "code": "Digit1",
              "hold": false
            }
          }
        ]
      },
      {
        "id": "lower",
        "valueType": "button",
        "bindings": [
          {
            "source": "keyboard.button",
            "config": {
              "code": "Digit2",
              "hold": false
            }
          }
        ]
      },
      {
        "id": "end",
        "valueType": "button",
        "bindings": [
          {
            "source": "keyboard.button",
            "config": {
              "code": "Digit3",
              "hold": false
            }
          }
        ]
      }
    ]
  },
  "rules": [
    {
      "id": "capture-north",
      "on": {
        "type": "input.action",
        "action": "upper",
        "edge": "press"
      },
      "if": {
        "op": "eq",
        "args": [
          {
            "state": "/north"
          },
          {
            "const": 0
          }
        ]
      },
      "do": [
        {
          "op": "state.set",
          "path": "/north",
          "value": {
            "state": "/player"
          }
        }
      ]
    },
    {
      "id": "capture-south",
      "on": {
        "type": "input.action",
        "action": "lower",
        "edge": "press"
      },
      "if": {
        "op": "eq",
        "args": [
          {
            "state": "/south"
          },
          {
            "const": 0
          }
        ]
      },
      "do": [
        {
          "op": "state.set",
          "path": "/south",
          "value": {
            "state": "/player"
          }
        }
      ]
    },
    {
      "id": "score-north-1",
      "on": {
        "type": "input.action",
        "action": "end",
        "edge": "press"
      },
      "if": {
        "op": "eq",
        "args": [
          {
            "state": "/north"
          },
          {
            "const": 1
          }
        ]
      },
      "do": [
        {
          "op": "state.add",
          "path": "/red",
          "value": 1
        }
      ]
    },
    {
      "id": "score-south-1",
      "on": {
        "type": "input.action",
        "action": "end",
        "edge": "press"
      },
      "if": {
        "op": "eq",
        "args": [
          {
            "state": "/south"
          },
          {
            "const": 1
          }
        ]
      },
      "do": [
        {
          "op": "state.add",
          "path": "/red",
          "value": 1
        }
      ]
    },
    {
      "id": "score-north-2",
      "on": {
        "type": "input.action",
        "action": "end",
        "edge": "press"
      },
      "if": {
        "op": "eq",
        "args": [
          {
            "state": "/north"
          },
          {
            "const": 2
          }
        ]
      },
      "do": [
        {
          "op": "state.add",
          "path": "/blue",
          "value": 1
        }
      ]
    },
    {
      "id": "score-south-2",
      "on": {
        "type": "input.action",
        "action": "end",
        "edge": "press"
      },
      "if": {
        "op": "eq",
        "args": [
          {
            "state": "/south"
          },
          {
            "const": 2
          }
        ]
      },
      "do": [
        {
          "op": "state.add",
          "path": "/blue",
          "value": 1
        }
      ]
    },
    {
      "id": "turn",
      "on": {
        "type": "input.action",
        "action": "end",
        "edge": "press"
      },
      "do": [
        {
          "op": "state.set",
          "path": "/player",
          "value": {
            "op": "sub",
            "args": [
              {
                "const": 3
              },
              {
                "state": "/player"
              }
            ]
          }
        },
        {
          "op": "state.add",
          "path": "/turns",
          "value": 1
        }
      ]
    }
  ],
  "outcomes": [
    {
      "id": "win",
      "priority": 0,
      "status": "won",
      "when": {
        "op": "gte",
        "args": [
          {
            "state": "/red"
          },
          {
            "const": 4
          }
        ]
      }
    },
    {
      "id": "lose",
      "priority": 1,
      "status": "lost",
      "when": {
        "op": "gte",
        "args": [
          {
            "state": "/blue"
          },
          {
            "const": 4
          }
        ]
      }
    }
  ],
  "presentation": {
    "hud": [
      {
        "id": "upper",
        "kind": "button",
        "text": "1 北区部署",
        "bind": {
