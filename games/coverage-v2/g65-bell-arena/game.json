            {
              "capability": {
                "id": "a2game.core.bootstrap",
                "version": "0.1.0"
              },
              "config": {
                "startedPath": "/booted",
                "tickPath": "/clock"
              }
            }
          ]
        }
      ]
    }
  ],
  "entryScene": "main",
  "state": {
    "clock": {
      "type": "int",
      "initial": 0
    },
    "booted": {
      "type": "bool",
      "initial": false
    },
    "hp": {
      "type": "int",
      "initial": 2
    },
    "rival": {
      "type": "int",
      "initial": 2
    },
    "blockUntil": {
      "type": "int",
      "initial": 0
    },
    "stunUntil": {
      "type": "int",
      "initial": 0
    },
    "attackUntil": {
      "type": "int",
      "initial": 0
    },
    "message": {
      "type": "string",
      "initial": "第 20、60 Tick 来袭"
    }
  },
  "inputs": {
    "actions": [
      {
        "id": "guard",
        "valueType": "button",
        "bindings": [
          {
            "source": "keyboard.button",
            "config": {
              "code": "KeyK",
              "hold": false
            }
          }
        ]
      },
      {
        "id": "attack",
        "valueType": "button",
        "bindings": [
          {
            "source": "keyboard.button",
            "config": {
              "code": "KeyJ",
              "hold": false
            }
          }
        ]
      }
    ]
  },
  "rules": [
    {
      "id": "brace",
      "on": {
        "type": "input.action",
        "action": "guard",
        "edge": "press"
      },
      "if": {
        "op": "gte",
        "args": [
          {
            "state": "/clock"
          },
          {
            "state": "/stunUntil"
          }
        ]
      },
      "do": [
        {
          "op": "state.set",
          "path": "/blockUntil",
          "value": {
            "op": "add",
            "args": [
              {
                "state": "/clock"
              },
              {
                "const": 7
              }
            ]
          }
        },
        {
          "op": "state.set",
          "path": "/message",
          "value": "举手防守"
        }
      ]
    },
    {
      "id": "blocked-20",
      "on": {
        "type": "level.tick"
      },
      "if": {
        "op": "and",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "state": "/clock"
              },
              {
                "const": 20
              }
            ]
          },
          {
            "op": "gt",
            "args": [
              {
                "state": "/blockUntil"
              },
              {
                "state": "/clock"
              }
            ]
          }
        ]
      },
      "do": [
        {
          "op": "state.set",
          "path": "/attackUntil",
          "value": 31
        },
        {
          "op": "state.set",
          "path": "/message",
          "value": "格挡成功 · 对手露出空档"
        }
      ]
    },
