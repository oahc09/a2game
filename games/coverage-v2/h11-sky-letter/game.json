              "hold": false
            }
          }
        ]
      }
    ]
  },
  "rules": [
    {
      "id": "checked",
      "on": {
        "type": "realtime.trigger"
      },
      "if": {
        "op": "eq",
        "args": [
          {
            "event": "/id"
          },
          {
            "const": "checkpoint"
          }
        ]
      },
      "do": [
        {
          "op": "state.set",
          "path": "/checkpoint",
          "value": true
        },
        {
          "op": "state.set",
          "path": "/message",
          "value": "抵达送信标记 · 前往闸门"
        }
      ]
    },
    {
      "id": "landed",
      "on": {
        "type": "realtime.landed"
      },
      "if": {
        "op": "eq",
        "args": [
          {
            "event": "/id"
          },
          {
            "const": "hero"
          }
        ]
      },
      "do": [
        {
          "op": "state.add",
          "path": "/landings",
          "value": 1
        }
      ]
    },
    {
      "id": "exit-begin",
      "on": {
        "type": "contact.begin"
      },
      "if": {
        "op": "and",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "event": "/pair"
              },
              {
                "const": "gate|hero"
              }
            ]
          },
          {
            "op": "eq",
            "args": [
              {
                "state": "/checkpoint"
              },
              {
                "const": true
              }
            ]
          },
          {
            "op": "eq",
            "args": [
              {
                "state": "/enemyDown"
              },
              {
                "const": true
              }
            ]
          }
        ]
      },
      "do": [
        {
          "op": "state.set",
          "path": "/finished",
          "value": true
        },
        {
          "op": "state.set",
          "path": "/message",
          "value": "信件已送达"
        }
      ]
    },
    {
      "id": "exit-stay",
      "on": {
        "type": "contact.stay"
      },
      "if": {
        "op": "and",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "event": "/pair"
              },
              {
                "const": "gate|hero"
              }
            ]
          },
          {
            "op": "eq",
            "args": [
              {
                "state": "/checkpoint"
              },
              {
                "const": true
              }
            ]
          },
          {
            "op": "eq",
            "args": [
              {
                "state": "/enemyDown"
              },
              {
                "const": true
              }
            ]
          }
        ]
      },
      "do": [
        {
          "op": "state.set",
          "path": "/finished",
          "value": true
        },
        {
          "op": "state.set",
          "path": "/message",
          "value": "信件已送达"
        }
      ]
    },
    {
      "id": "agree",
      "on": {
        "type": "input.action",
        "action": "accept",
        "edge": "press"
      },
      "if": {
        "op": "eq",
        "args": [
          {
            "state": "/quest"
          },
          {
            "const": 0
          }
        ]
      },
      "do": [
        {
          "op": "state.set",
          "path": "/quest",
          "value": 1
        },
        {
          "op": "state.set",
          "path": "/enemyDown",
          "value": true
        },
        {
          "op": "state.set",
          "path": "/message",
          "value": "守桥人已升桥 · 带信前往对岸"
        }
      ]
    },
    {
      "id": "decline",
      "on": {
        "type": "input.action",
        "action": "decline",
        "edge": "press"
      },
      "if": {
        "op": "eq",
        "args": [
          {
            "state": "/quest"
          },
          {
            "const": 0
          }
        ]
      },
      "do": [
        {
          "op": "state.set",
          "path": "/message",
          "value": "拒绝送信 · 桥面保持低位"
        }
      ]
    }
  ],
  "outcomes": [
    {
      "id": "fall",
