  "rules": [
    {
      "id": "loot",
      "on": {
        "type": "input.action",
        "action": "loot",
        "edge": "press"
      },
      "do": [
        {
          "op": "state.set",
          "path": "/loot",
          "value": 1
        }
      ]
    },
    {
      "id": "equip",
      "on": {
        "type": "input.action",
        "action": "equip",
        "edge": "press"
      },
      "if": {
        "op": "eq",
        "args": [
          {
            "state": "/loot"
          },
          {
            "const": 1
          }
        ]
      },
      "do": [
        {
          "op": "state.set",
          "path": "/affix",
          "value": 2
        }
      ]
    },
    {
      "id": "draw",
      "on": {
        "type": "input.action",
        "action": "draw",
        "edge": "press"
      },
      "if": {
        "op": "eq",
        "args": [
          {
            "state": "/hand"
          },
          {
            "const": 0
          }
        ]
      },
      "do": [
        {
          "op": "state.set",
          "path": "/hand",
          "value": 1
        }
      ]
    },
    {
      "id": "play",
      "on": {
        "type": "input.action",
        "action": "play",
        "edge": "press"
      },
      "if": {
        "op": "and",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "state": "/hand"
              },
              {
                "const": 1
              }
            ]
          },
          {
            "op": "gte",
            "args": [
              {
                "state": "/energy"
              },
              {
                "const": 1
              }
            ]
          }
        ]
      },
      "do": [
        {
          "op": "state.set",
          "path": "/hand",
          "value": 0
        },
        {
          "op": "state.add",
          "path": "/energy",
          "value": -1
        },
        {
          "op": "state.set",
          "path": "/hp",
          "value": {
            "op": "max",
            "args": [
              {
                "const": 0
              },
              {
                "op": "sub",
                "args": [
                  {
                    "state": "/hp"
                  },
                  {
                    "op": "add",
                    "args": [
                      {
                        "const": 3
                      },
                      {
                        "state": "/affix"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        }
      ]
    }
  ],
