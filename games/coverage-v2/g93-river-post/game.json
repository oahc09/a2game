          "action": "hand"
        }
      },
      {
        "id": "button-gate",
        "kind": "button",
        "text": "4 进入山门",
        "bind": {
          "action": "gate"
        }
      },
      {
        "id": "button-final",
        "kind": "button",
        "text": "5 交印信",
        "bind": {
          "action": "final"
        }
      }
    ],
