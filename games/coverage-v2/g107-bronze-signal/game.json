  "rules": [
    {
      "id": "rejected",
      "on": {
        "type": "defense.invalid"
      },
      "do": [
        {
          "op": "state.set",
          "path": "/message",
          "value": "指令被拒绝 · 先选不同格的同级塔"
        }
      ]
    },
    {
      "id": "merged-range",
      "on": {
        "type": "defense.merged"
      },
      "if": {
        "op": "eq",
        "args": [
          {
            "state": "/defense/towers/0/specialization"
          },
          {
            "const": "range"
          }
        ]
      },
      "do": [
        {
          "op": "state.set",
          "path": "/message",
          "value": "长射程塔就绪 · 提前开火"
        }
      ]
    },
    {
      "id": "merged-slow",
      "on": {
        "type": "defense.merged"
      },
      "if": {
        "op": "eq",
        "args": [
          {
            "state": "/defense/towers/0/specialization"
          },
          {
            "const": "slow"
          }
        ]
      },
      "do": [
        {
          "op": "state.set",
          "path": "/message",
          "value": "减速塔就绪 · 命中后减慢行进"
        }
      ]
    }
