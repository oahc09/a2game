{
  "format": "a2game",
  "specVersion": "0.1.0",
  "id": "local.coverage-v2.tide-lantern",
  "revision": 1,
  "meta": {
    "title": "潮仓寻灯",
    "description": "在旧仓找到灯壳与灯芯，组合成航灯，再前往码头点亮航标。",
    "genres": [
      "puzzle"
    ]
  },
  "requires": {
    "all": [
      {
        "id": "a2game.core.state",
        "version": "0.1.0"
      },
      {
        "id": "a2game.core.rules",
        "version": "0.1.0"
      },
      {
        "id": "a2game.core.flow",
        "version": "0.1.0"
      },
      {
        "id": "a2game.rules.state-set",
        "version": "0.1.0"
      },
      {
        "id": "a2game.input.keyboard.button",
        "version": "0.1.0"
      },
      {
        "id": "a2game.visual.text",
        "version": "0.1.0"
      },
      {
        "id": "a2game.visual.scene2d",
        "version": "0.1.0"
      },
      {
        "id": "a2game.rules.state-add",
        "version": "0.1.0"
      },
      {
        "id": "a2game.core.bootstrap",
        "version": "0.1.0"
      },
      {
        "id": "a2game.core.clock",
        "version": "0.1.0"
      }
    ]
  },
  "world": {
    "dimension": "2d",
    "coordinateSystem": "rh-y-up",
    "units": "meter",
    "clock": {
      "tickHz": 60,
      "seed": 12122,
      "maxCatchUpTicks": 5
    }
  },
  "assets": {},
  "prototypes": {},
  "scenes": [
    {
      "id": "main",
      "entities": []
    }
  ],
  "entryScene": "main",
  "state": {
    "room": {
      "type": "int",
      "initial": 0
    },
    "shell": {
      "type": "int",
      "initial": 0
    },
    "wick": {
      "type": "int",
      "initial": 0
    },
    "lantern": {
      "type": "int",
      "initial": 0
    },
    "done": {
      "type": "int",
      "initial": 0
    },
    "message": {
      "type": "string",
      "initial": "点仓库内的木箱和挂钩"
    }
  },
  "inputs": {
    "actions": [
      {
        "id": "crate",
        "valueType": "button",
        "bindings": [
          {
            "source": "keyboard.button",
            "config": {
              "code": "Digit1",
              "hold": false
            }
          }
        ]
      },
      {
        "id": "hook",
        "valueType": "button",
        "bindings": [
          {
            "source": "keyboard.button",
            "config": {
              "code": "Digit2",
              "hold": false
            }
          }
        ]
      },
      {
        "id": "assemble",
        "valueType": "button",
        "bindings": [
          {
            "source": "keyboard.button",
            "config": {
              "code": "Digit3",
              "hold": false
            }
          }
        ]
      },
      {
        "id": "dock",
        "valueType": "button",
        "bindings": [
          {
            "source": "keyboard.button",
            "config": {
              "code": "Digit4",
              "hold": false
            }
          }
        ]
      },
      {
        "id": "light",
        "valueType": "button",
        "bindings": [
          {
            "source": "keyboard.button",
            "config": {
              "code": "Digit5",
              "hold": false
            }
          }
        ]
      },
      {
        "id": "return",
        "valueType": "button",
        "bindings": [
          {
            "source": "keyboard.button",
            "config": {
              "code": "Digit6",
              "hold": false
            }
          }
        ]
      }
    ]
  },
  "rules": [
    {
      "id": "shell",
      "on": {
        "type": "input.action",
        "action": "crate",
        "edge": "press"
      },
      "if": {
        "op": "and",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "state": "/room"
              },
              {
                "const": 0
              }
            ]
          },
          {
            "op": "eq",
            "args": [
              {
                "state": "/shell"
              },
              {
                "const": 0
              }
            ]
          },
          {
            "op": "eq",
            "args": [
              {
                "state": "/lantern"
              },
              {
                "const": 0
              }
            ]
          }
        ]
      },
      "do": [
        {
          "op": "state.set",
          "path": "/shell",
          "value": 1
        },
        {
          "op": "state.set",
          "path": "/message",
          "value": "取得灯壳"
        }
      ]
    },
    {
      "id": "wick",
      "on": {
        "type": "input.action",
        "action": "hook",
        "edge": "press"
      },
      "if": {
        "op": "and",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "state": "/room"
              },
              {
                "const": 0
              }
            ]
          },
          {
            "op": "eq",
            "args": [
              {
                "state": "/wick"
              },
              {
                "const": 0
              }
            ]
          },
          {
            "op": "eq",
            "args": [
              {
                "state": "/lantern"
              },
              {
                "const": 0
              }
            ]
          }
        ]
      },
      "do": [
        {
          "op": "state.set",
          "path": "/wick",
          "value": 1
        },
        {
          "op": "state.set",
          "path": "/message",
          "value": "取得灯芯"
        }
      ]
    },
    {
      "id": "assemble",
      "on": {
        "type": "input.action",
        "action": "assemble",
        "edge": "press"
      },
      "if": {
        "op": "and",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "state": "/shell"
              },
              {
                "const": 1
              }
            ]
          },
          {
            "op": "eq",
            "args": [
              {
                "state": "/wick"
              },
              {
                "const": 1
              }
            ]
          }
        ]
      },
      "do": [
        {
          "op": "state.set",
          "path": "/shell",
          "value": 0
        },
        {
          "op": "state.set",
          "path": "/wick",
          "value": 0
        },
        {
          "op": "state.set",
          "path": "/lantern",
          "value": 1
        },
        {
          "op": "state.set",
          "path": "/message",
          "value": "航灯组装完成 · 前往码头"
        }
      ]
    },
    {
      "id": "dock",
      "on": {
        "type": "input.action",
        "action": "dock",
        "edge": "press"
      },
      "do": [
        {
          "op": "state.set",
          "path": "/room",
          "value": 1
        },
        {
          "op": "state.set",
          "path": "/message",
          "value": "码头航标需要一盏完整航灯"
        }
      ]
    },
    {
      "id": "return",
      "on": {
        "type": "input.action",
        "action": "return",
        "edge": "press"
      },
      "do": [
        {
          "op": "state.set",
          "path": "/room",
          "value": 0
        },
        {
          "op": "state.set",
          "path": "/message",
          "value": "返回旧仓"
        }
      ]
    },
    {
      "id": "light",
      "on": {
        "type": "input.action",
        "action": "light",
        "edge": "press"
      },
      "if": {
        "op": "and",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "state": "/room"
              },
              {
                "const": 1
              }
            ]
          },
          {
            "op": "eq",
            "args": [
              {
                "state": "/lantern"
              },
              {
                "const": 1
              }
            ]
          }
        ]
      },
      "do": [
        {
          "op": "state.set",
          "path": "/lantern",
          "value": 0
        },
        {
          "op": "state.set",
          "path": "/done",
          "value": 1
        },
        {
          "op": "state.set",
          "path": "/message",
          "value": "航标已点亮"
        }
      ]
    }
  ],
  "outcomes": [
    {
      "id": "cleared",
      "status": "won",
      "priority": 0,
      "when": {
        "op": "eq",
        "args": [
          {
            "state": "/done"
          },
          {
            "const": 1
          }
        ]
      }
    }
  ],
  "presentation": {
    "hud": [
