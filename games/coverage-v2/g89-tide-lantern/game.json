      },
      {
        "id": "choice-assemble",
        "kind": "button",
        "text": "3 组合航灯",
        "bind": {
          "action": "assemble"
        }
      },
      {
        "id": "choice-dock",
        "kind": "button",
        "text": "4 前往码头",
        "bind": {
          "action": "dock"
        }
      },
      {
        "id": "choice-light",
        "kind": "button",
        "text": "5 点亮航标",
        "bind": {
          "action": "light"
        }
      },
      {
        "id": "choice-return",
