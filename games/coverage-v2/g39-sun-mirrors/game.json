              "capability": {
                "id": "a2game.core.bootstrap",
                "version": "0.1.0"
              },
              "config": {
                "startedPath": "/booted",
                "tickPath": "/clock"
              }
            }
          ]
        }
      ]
    }
  ],
  "entryScene": "main",
  "state": {
    "clock": {
      "type": "int",
      "initial": 0
    },
    "booted": {
      "type": "bool",
      "initial": false
    },
    "mirrorA": {
      "type": "bool",
      "initial": false
    },
    "mirrorB": {
      "type": "bool",
      "initial": false
    },
    "reflected": {
      "type": "bool",
      "initial": false
    },
    "hit": {
      "type": "bool",
      "initial": false
    },
    "missA": {
      "type": "bool",
      "initial": false
    },
    "missB": {
      "type": "bool",
      "initial": false
    }
  },
  "inputs": {
    "actions": [
      {
        "id": "mirrorA",
        "valueType": "button",
        "bindings": [
          {
            "source": "keyboard.button",
            "config": {
              "code": "Digit1",
              "hold": false
            }
          }
        ]
      },
      {
        "id": "mirrorB",
        "valueType": "button",
        "bindings": [
          {
            "source": "keyboard.button",
            "config": {
              "code": "Digit2",
              "hold": false
            }
          }
        ]
      }
    ]
  },
  "rules": [
    {
      "id": "toggle-mirrorA",
      "on": {
        "type": "input.action",
        "action": "mirrorA",
        "edge": "press"
      },
      "do": [
        {
          "op": "state.set",
          "path": "/mirrorA",
          "value": {
            "op": "eq",
            "args": [
              {
                "state": "/mirrorA"
              },
              {
                "const": false
              }
            ]
          }
        }
      ]
    },
    {
      "id": "toggle-mirrorB",
      "on": {
        "type": "input.action",
        "action": "mirrorB",
        "edge": "press"
      },
      "do": [
        {
          "op": "state.set",
          "path": "/mirrorB",
          "value": {
            "op": "eq",
            "args": [
              {
                "state": "/mirrorB"
              },
              {
                "const": false
              }
            ]
          }
        }
      ]
    },
    {
      "id": "evaluate-network",
      "on": {
        "type": "level.tick"
      },
      "do": [
        {
          "op": "state.set",
          "path": "/reflected",
          "value": {
            "op": "eq",
            "args": [
              {
                "state": "/mirrorA"
              },
              {
                "const": true
              }
            ]
          }
        },
        {
          "op": "state.set",
          "path": "/hit",
          "value": {
            "op": "and",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "state": "/mirrorA"
                  },
                  {
                    "const": true
                  }
                ]
              },
              {
                "op": "eq",
                "args": [
                  {
                    "state": "/mirrorB"
                  },
                  {
                    "const": true
                  }
                ]
              }
            ]
          }
        },
        {
          "op": "state.set",
          "path": "/missA",
          "value": {
            "op": "eq",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "state": "/mirrorA"
                  },
                  {
                    "const": true
                  }
                ]
              },
              {
                "const": false
              }
            ]
          }
        },
        {
          "op": "state.set",
          "path": "/missB",
          "value": {
            "op": "and",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "state": "/mirrorA"
                  },
                  {
                    "const": true
                  }
                ]
              },
              {
                "op": "eq",
                "args": [
                  {
                    "state": "/mirrorB"
                  },
                  {
                    "const": false
                  }
                ]
              }
            ]
          }
        }
      ]
    }
  ],
  "outcomes": [
    {
      "id": "network-finished",
      "status": "won",
      "priority": 0,
      "when": {
        "op": "eq",
        "args": [
          {
            "state": "/hit"
          },
          {
            "const": true
          }
        ]
      }
    }
  ],
