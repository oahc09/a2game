  },
  "rules": [
    {
      "id": "request-a-shot",
      "on": {
        "type": "input.action",
        "action": "fire",
        "edge": "press"
      },
      "if": {
        "op": "gt",
        "args": [
          {
            "state": "/ammo"
          },
          {
            "const": 0
          }
        ]
      },
      "do": [
        {
          "op": "state.set",
          "path": "/request",
          "value": true
        }
      ]
    },
    {
      "id": "clear-request",
      "on": {
        "type": "level.tick"
      },
      "if": {
        "op": "eq",
        "args": [
          {
            "state": "/request"
          },
          {
            "const": true
          }
        ]
      },
      "do": [
        {
          "op": "state.set",
          "path": "/request",
          "value": false
        }
      ]
    },
    {
      "id": "consume-on-fire",
      "on": {
        "type": "combat.fired"
      },
      "do": [
        {
          "op": "state.add",
          "path": "/ammo",
          "value": -1
        }
      ]
    },
    {
      "id": "enter-next-battle",
      "on": {
        "type": "combat.death"
      },
      "if": {
        "op": "eq",
        "args": [
          {
            "event": "/id"
          },
          {
            "const": "bronze"
          }
        ]
      },
      "do": [
        {
          "op": "state.set",
          "path": "/stage",
          "value": 2
        },
        {
          "op": "state.set",
          "path": "/message",
          "value": "第二场 · 留两发等待守卫出现"
        }
      ]
    }
  ],
  "outcomes": [
    {
      "id": "bosses-cleared",
      "status": "won",
      "priority": 0,
      "when": {
        "op": "eq",
        "args": [
          {
            "state": "/world/score"
          },
          {
            "const": 2
          }
        ]
      }
    },
    {
      "id": "empty-ammo",
      "status": "lost",
      "priority": 1,
      "when": {
        "op": "eq",
        "args": [
          {
            "state": "/ammo"
          },
          {
            "const": 0
          }
        ]
      }
    }
  ],
