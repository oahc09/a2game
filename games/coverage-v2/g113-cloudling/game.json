              }
            ]
          },
          {
            "op": "gte",
            "args": [
              {
                "state": "/clock"
              },
              {
                "const": 720
              }
            ]
          }
        ]
      }
    },
    {
      "id": "grown",
      "status": "won",
      "priority": 1,
      "when": {
        "op": "gte",
        "args": [
          {
            "state": "/growth"
          },
          {
            "const": 3
          }
        ]
      }
    }
  ],
