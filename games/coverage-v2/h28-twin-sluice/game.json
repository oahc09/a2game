    "booted": {
      "type": "bool",
      "initial": false
    },
    "left": {
      "type": "bool",
      "initial": false
    },
    "right": {
      "type": "bool",
      "initial": false
    },
    "done": {
      "type": "bool",
      "initial": false
    }
  },
  "inputs": {
    "actions": [
      {
        "id": "left",
        "valueType": "button",
        "bindings": [
          {
            "source": "keyboard.button",
            "config": {
              "code": "KeyA",
              "hold": true
            }
          }
        ]
      },
      {
        "id": "right",
        "valueType": "button",
        "bindings": [
          {
            "source": "keyboard.button",
            "config": {
              "code": "ArrowRight",
              "hold": true
            }
          }
        ]
      }
    ]
  },
  "rules": [
    {
      "id": "down-left",
      "on": {
        "type": "input.action",
        "action": "left",
        "edge": "press"
      },
      "do": [
        {
          "op": "state.set",
          "path": "/left",
          "value": true
        }
      ]
    },
    {
      "id": "up-left",
      "on": {
        "type": "input.action",
        "action": "left",
        "edge": "release"
      },
      "do": [
        {
          "op": "state.set",
          "path": "/left",
          "value": false
        }
      ]
    },
    {
      "id": "cancel-left",
      "on": {
        "type": "input.action",
        "action": "left",
        "edge": "cancel"
      },
      "do": [
        {
          "op": "state.set",
          "path": "/left",
          "value": false
        }
      ]
    },
    {
      "id": "down-right",
      "on": {
        "type": "input.action",
        "action": "right",
        "edge": "press"
      },
      "do": [
        {
          "op": "state.set",
          "path": "/right",
          "value": true
        }
      ]
    },
    {
      "id": "up-right",
      "on": {
        "type": "input.action",
        "action": "right",
        "edge": "release"
      },
      "do": [
        {
          "op": "state.set",
          "path": "/right",
          "value": false
        }
      ]
    },
    {
      "id": "cancel-right",
      "on": {
        "type": "input.action",
        "action": "right",
        "edge": "cancel"
      },
      "do": [
        {
          "op": "state.set",
          "path": "/right",
          "value": false
        }
      ]
    },
    {
      "id": "open",
      "on": {
        "type": "input.action",
        "action": "right",
        "edge": "press"
      },
      "if": {
        "op": "eq",
        "args": [
          {
            "state": "/left"
          },
          {
            "const": true
          }
        ]
      },
      "do": [
        {
          "op": "state.set",
          "path": "/done",
          "value": true
        }
      ]
    }
  ],
  "outcomes": [
    {
      "id": "open",
      "priority": 0,
      "status": "won",
      "when": {
        "op": "eq",
        "args": [
          {
            "state": "/done"
          },
          {
            "const": true
          }
        ]
      }
    }
