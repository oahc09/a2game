  "rules": [
    {
      "id": "flip-up",
      "on": {
        "type": "input.action",
        "action": "switch",
        "edge": "press"
      },
      "if": {
        "op": "eq",
        "args": [
          {
            "state": "/inverted"
          },
          {
            "const": false
          }
        ]
      },
      "do": [
        {
          "op": "state.set",
          "path": "/inverted",
          "value": true
        }
      ]
    },
    {
      "id": "land-ceiling",
      "on": {
        "type": "contact.begin"
      },
      "if": {
        "op": "and",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "state": "/inverted"
              },
              {
                "const": true
              }
            ]
          },
          {
            "op": "eq",
            "args": [
              {
                "event": "/pair"
              },
              {
                "const": "ceiling|hero"
              }
            ]
          }
        ]
      },
      "do": [
        {
          "op": "state.set",
          "path": "/finished",
          "value": true
        }
      ]
    }
  ],
  "outcomes": [
    {
      "id": "fall",
      "status": "lost",
      "priority": 0,
