        },
        {
          "op": "injectRaw",
          "raw": {
            "source": "keyboard",
            "kind": "up",
            "payload": {
              "code": "KeyB"
            }
          }
        },
        {
          "op": "step",
          "ticks": 1
        },
        {
          "op": "assertEvent",
          "eventType": "combat.bomb",
          "count": 1
        },
        {
          "op": "restart"
        },
        {
          "op": "assert",
          "path": "/state/world/bombs",
          "equals": 1
        },
        {
          "op": "assert",
          "path": "/state/world/score",
          "equals": 0
        }
      ]
    },
