{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Generator internal GamePlan v1; never a Runtime format",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "concept", "mechanisms", "controls", "entities", "stateModel", "gameFlow", "presentation", "testIntent", "capabilities", "hostProfile", "unmetCapabilities"],
  "properties": {
    "format": {"const": "a2game-game-plan"},
    "version": {"const": 1},
    "concept": {"type": "object", "additionalProperties": false, "required": ["genre", "dimension", "orientation"], "properties": {"genre": {"$ref": "#/$defs/text"}, "dimension": {"enum": ["2d", "3d"]}, "orientation": {"enum": ["portrait", "landscape", "responsive"]}}},
    "mechanisms": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["id", "capabilities", "entities", "stateRefs"], "properties": {"id": {"$ref": "#/$defs/id"}, "capabilities": {"$ref": "#/$defs/refs"}, "entities": {"$ref": "#/$defs/ids"}, "stateRefs": {"$ref": "#/$defs/ids"}}}},
    "controls": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["source", "capability"], "properties": {"source": {"$ref": "#/$defs/id"}, "capability": {"$ref": "#/$defs/ref"}}}},
    "entities": {"$ref": "#/$defs/ids"},
    "stateModel": {"$ref": "#/$defs/ids"},
    "gameFlow": {"type": "object", "additionalProperties": false, "required": ["win", "lose"], "properties": {"win": {"$ref": "#/$defs/text"}, "lose": {"$ref": "#/$defs/text"}}},
    "presentation": {"type": "object", "additionalProperties": false, "required": ["style", "resources"], "properties": {"style": {"$ref": "#/$defs/text"}, "resources": {"enum": ["primitives", "reviewed-local"]}}},
    "testIntent": {"type": "array", "uniqueItems": true, "minItems": 2, "maxItems": 16, "items": {"enum": ["one-win", "one-negative", "restart", "pause", "terminal-freeze", "input-cancel", "determinism", "dispose"]}, "allOf": [{"contains": {"const": "one-win"}}, {"contains": {"const": "one-negative"}}]},
    "capabilities": {"$ref": "#/$defs/refs"},
    "hostProfile": {"type": "object", "additionalProperties": false, "required": ["id", "inputSources", "backends"], "properties": {"id": {"const": "generator-scene2d-v1"}, "inputSources": {"$ref": "#/$defs/ids"}, "backends": {"const": ["air", "three"]}}},
    "unmetCapabilities": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/text"}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]*$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 1000},
    "ids": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "ref": {"type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": {"id": {"type": "string", "pattern": "^a2game(?:\\.[a-z][a-z0-9-]*){2,}$"}, "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"}}},
    "refs": {"type": "array", "minItems": 1, "maxItems": 127, "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}}
  }
}
