{
  "name": "@a2game/headless-reference",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Engine-neutral A2Game 1.0.0 reference workspace (GameSpec 0.1.0, pre-production)",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "conformance": "npm run build && node scripts/run-conformance.mjs",
    "spec:validate": "python specs/v0.1/tools/validate_specs.py",
    "schema:full": "python scripts/preflight.py",
    "catalog:build": "npm run build && npm run schema:full && node scripts/create-validated-catalog.mjs && node scripts/update-capability-index.mjs",
    "player:serve": "node scripts/serve.mjs",
    "sdk:prepare": "node scripts/prepare-sdks.mjs",
    "g2:real": "node scripts/g2-real.mjs",
    "content:e2e": "node scripts/content-browser.mjs",
    "stage:e2e": "node scripts/content-browser.mjs --stage",
    "puzzles:e2e": "node scripts/puzzle-browser.mjs",
    "verify:receipt": "node scripts/verify-workspace.mjs",
    "project:check": "node scripts/check-project.mjs",
    "verify": "npm run project:check && npm test && npm run spec:validate && npm run schema:full && npm run conformance && npm run catalog:build",
    "realtime:e2e": "node scripts/mechanism-browser.mjs --suite=realtime",
    "strategy:e2e": "node scripts/mechanism-browser.mjs --suite=strategy",
    "mobile:e2e": "node scripts/mobile-browser.mjs",
    "candidates:e2e": "node scripts/candidates-browser.mjs",
    "agent:run": "node scripts/agent-workflow.mjs",
    "agent:e2e": "node scripts/agent-browser.mjs",
    "agent:fixture": "node scripts/run-agent-fixture.mjs",
    "compat:e2e": "node scripts/compat-browser.mjs",
    "compat:matrix": "node scripts/compat-matrix.mjs",
    "performance:profile": "node scripts/benchmark-profile.mjs",
    "save:replay": "node scripts/replay-save.mjs",
    "variants:e2e": "node scripts/candidates-browser.mjs --variants",
    "gameplay:check": "npm run build && node scripts/gameplay-acceptance.mjs",
    "acceptance:build": "node scripts/final-acceptance.mjs build",
    "acceptance:check": "node scripts/final-acceptance.mjs check",
    "acceptance:ready": "node scripts/final-acceptance.mjs check --require-ready",
    "g3:plan": "node scripts/g3-batch.mjs plan",
    "g3:run": "node scripts/g3-batch.mjs run",
    "g3:e2e": "node scripts/g3-browser.mjs",
    "g3:fixture": "node scripts/run-g3-fixture.mjs",
    "g3:codex": "node scripts/g3-codex.mjs"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "playwright": "1.64.1",
    "pngjs": "7.0.0",
    "three": "0.186.1",
    "typescript": "5.8.3"
  },
  "dependencies": {
    "cannon-es": "0.20.0"
  }
}
