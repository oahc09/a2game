{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:a2game:schemas:adapter:0.1.0",
  "title": "A2Game Adapter Capability Manifest 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "manifestVersion",
    "adapterId",
    "adapterVersion",
    "runtimeVersion",
    "status",
    "supportedCapabilities",
    "physicsProfiles",
    "targetPlatforms",
    "limitations"
  ],
  "properties": {
    "format": {
      "const": "a2game-adapter-capabilities"
    },
    "manifestVersion": {
      "const": "0.1.0"
    },
    "adapterId": {
      "type": "string",
      "minLength": 1
    },
    "adapterVersion": {
      "type": "string",
      "minLength": 1
    },
    "runtimeVersion": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "planned",
        "implemented-unverified",
        "verified"
      ]
    },
    "supportedCapabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/capRef"
      }
    },
    "physicsProfiles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "targetPlatforms": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "capRef": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*){2,}$"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        }
      },
      "additionalProperties": false
    }
  }
}
