{
  "format": "a2game",
  "specVersion": "0.1.0",
  "id": "org.a2game.samples.tap-target",
  "revision": 2,
  "meta": {
    "title": "点击两次获胜",
    "description": "每次有效点击得 1 分，达到 2 分获胜。",
    "genres": [
      "casual",
      "puzzle"
    ]
  },
  "requires": {
    "all": [
      {
        "id": "a2game.core.state",
        "version": "0.1.0"
      },
      {
        "id": "a2game.core.rules",
        "version": "0.1.0"
      },
      {
        "id": "a2game.core.flow",
        "version": "0.1.0"
      },
      {
        "id": "a2game.rules.state-add",
        "version": "0.1.0"
      },
      {
        "id": "a2game.visual.text",
        "version": "0.1.0"
      },
      {
        "id": "a2game.visual.scene2d",
        "version": "0.1.0"
      }
    ],
    "anyOf": [
      [
        {
          "id": "a2game.input.touch.tap",
          "version": "0.1.0"
        },
        {
          "id": "a2game.input.keyboard.button",
          "version": "0.1.0"
        }
      ]
    ]
  },
  "world": {
    "dimension": "2d",
    "coordinateSystem": "rh-y-up",
    "units": "meter",
    "clock": {
      "tickHz": 60,
      "seed": 42,
      "maxCatchUpTicks": 5
    }
  },
  "assets": {},
  "prototypes": {},
  "scenes": [
    {
      "id": "main",
      "entities": []
    }
  ],
  "entryScene": "main",
  "state": {
    "score": {
      "type": "int",
      "initial": 0
    },
    "goal": {
      "type": "int",
      "initial": 2
    }
  },
  "inputs": {
    "actions": [
      {
        "id": "collect",
        "valueType": "button",
        "policy": "first-ready",
        "bindings": [
          {
            "source": "touch.tap",
            "config": {
              "region": "playfield"
            }
          },
          {
            "source": "keyboard.button",
            "config": {
              "code": "Space"
            }
          }
        ]
      }
    ],
    "traceRecording": "disabled"
  },
  "rules": [
    {
      "id": "reward-on-press",
      "priority": 0,
      "on": {
        "type": "input.action",
        "action": "collect",
        "edge": "press"
      },
      "if": {
        "op": "lt",
        "args": [
          {
            "state": "/score"
          },
          {
            "state": "/goal"
          }
        ]
      },
      "do": [
        {
          "op": "state.add",
          "path": "/score",
          "value": 1
        }
      ]
    }
  ],
  "outcomes": [
    {
      "id": "all-collected",
      "status": "won",
      "priority": 0,
      "when": {
        "op": "gte",
        "args": [
          {
            "state": "/score"
          },
          {
            "state": "/goal"
          }
        ]
      }
    }
  ],
  "presentation": {
    "hud": [
      {
        "id": "scoreLabel",
        "kind": "text",
        "text": "点击屏幕得分",
        "bind": {
          "text": {
            "template": "Score: {0} / {1}",
            "args": [
              {
                "state": "/score"
              },
              {
                "state": "/goal"
              }
            ]
          }
        }
      }
    ],
    "cues": [],
    "scene2d": {
      "width": 8,
      "height": 6,
      "background": "#0d1729",
      "nodes": [
        {
          "id": "outer",
          "kind": "circle",
          "at": [
            0,
            0
          ],
          "fill": "#173955",
          "radius": 1.7
        },
        {
          "id": "target",
          "kind": "circle",
          "at": [
            0,
            0
          ],
          "fill": "#2c91c5",
          "radius": 1.34
        },
        {
          "id": "center",
          "kind": "circle",
          "at": [
            0,
            0
          ],
          "fill": "#6ed2ef",
          "radius": 0.85
        },
        {
          "id": "score",
          "kind": "text",
          "at": [
            0,
            0
          ],
          "fill": "#0c3556",
          "fontSize": 0.8,
          "text": {
            "state": "/score"
          }
        },
        {
          "id": "title",
          "kind": "text",
          "at": [
            0,
            2.45
          ],
          "fill": "#c8e5fd",
          "fontSize": 0.32,
          "text": {
            "literal": "A2Game / Tap to score"
          }
        }
      ]
    }
  },
  "tests": [
    "../tests/tap-target.conformance.json"
  ],
  "extensions": {}
}
